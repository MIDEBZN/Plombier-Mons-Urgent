---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import DesktopStickyCall from '../components/DesktopStickyCall.astro';
import WhatsAppChatWidget from '../components/WhatsAppChatWidget.astro';
import GuaranteesBanner from '../components/GuaranteesBanner.astro';
import GoogleMapSection from '../components/GoogleMapSection.astro';
import '../styles/global.css';
import criticalCss from '../styles/critical.css?raw';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  currentPage?: string;
}

const {
  title,
  description,
  canonicalPath = '',
  currentPage = 'accueil',
} = Astro.props;

const canonicalUrl = `https://www.plombiermonsurgent.be${canonicalPath}`;
---

<!DOCTYPE html>
<html lang="fr-BE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    
    <!-- Critical CSS (Inlined for instant FCP and zero layout shift) -->
    <style is:inline set:html={criticalCss}></style>

    <!-- Favicon & Touch Icons (WebP & SVG Prioritized) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/webp" sizes="32x32" href="/favicon-32x32.webp" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/webp" sizes="16x16" href="/favicon-16x16.webp" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.webp" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Open Graph (WebP Format) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:site_name" content="Plombier Mons Urgent" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://www.plombiermonsurgent.be/logo-512.webp" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.plombiermonsurgent.be/logo-512.webp" />

    <!-- DNS Prefetch, Preconnect & Non-Blocking Font Loading (Core Web Vitals) -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@400;500;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@400;500;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@400;500;700;800&display=swap"
      />
    </noscript>

    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      />
    </noscript>

    <!-- Complete Plumbing Schema Markup with Service Catalog (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": ["Plumber", "EmergencyService"],
            "@id": "https://www.plombiermonsurgent.be/#organization",
            "name": "Plombier Mons Urgent",
            "alternateName": "Plombier Mons 24/7 Dépannage",
            "legalName": "Plombier Mons Urgent SRL",
            "url": "https://www.plombiermonsurgent.be",
            "logo": "https://www.plombiermonsurgent.be/logo-512.webp",
            "image": "https://www.plombiermonsurgent.be/logo-512.webp",
            "telephone": "+32489164378",
            "email": "contact@plombiermonsurgent.be",
            "hasMap": "https://maps.app.goo.gl/kYQARdAPhii8cHBj6",
            "priceRange": "€€",
            "currenciesAccepted": "EUR",
            "paymentAccepted": "Cash, Bancontact, Payconiq, Maestro, Visa, Mastercard, Virement bancaire instantané",
            "foundingDate": "2009",
            "description": "Artisan plombier et chauffagiste d'urgence à Mons et dans tout le Borinage. Dépannage 24h/24 et 7j/7 en 20 à 30 minutes pour fuite d'eau, canalisation bouchée, panne de chaudière, boiler et adoucisseur. Agréé CERGA Gaz et PEB Wallonie, assuré AXA Belgium.",
            "knowsAbout": [
              "Dépannage d'urgence plomberie 24/7 en 20 à 30 minutes",
              "Agréé CERGA Gaz N° 09-34821",
              "Attestation PEB Région Wallonne",
              "Assurance AXA Belgium Police N° 730.294.108",
              "Habilité Belgaqua eau potable",
              "Garantie décennale travaux sanitaires"
            ],
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Rue du Fisch Club 31B",
              "addressLocality": "Mons",
              "postalCode": "7000",
              "addressRegion": "Hainaut",
              "addressCountry": "BE"
            },
            "geo": {
              "@type": "GeoCoordinates",
              "latitude": 50.4542,
              "longitude": 3.9567
            },
            "openingHoursSpecification": [
              {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
                "opens": "00:00",
                "closes": "23:59"
              }
            ],
            "aggregateRating": {
              "@type": "AggregateRating",
              "ratingValue": "4.9",
              "reviewCount": "348",
              "bestRating": "5",
              "worstRating": "1"
            },
            "areaServed": [
              { "@type": "City", "name": "Mons", "postalCode": "7000" },
              { "@type": "City", "name": "Ghlin", "postalCode": "7011" },
              { "@type": "City", "name": "Jemappes", "postalCode": "7012" },
              { "@type": "City", "name": "Flénu", "postalCode": "7012" },
              { "@type": "City", "name": "Nimy", "postalCode": "7020" },
              { "@type": "City", "name": "Maisières", "postalCode": "7020" },
              { "@type": "City", "name": "Casteau", "postalCode": "7020" },
              { "@type": "City", "name": "Havré", "postalCode": "7021" },
              { "@type": "City", "name": "Hyon", "postalCode": "7022" },
              { "@type": "City", "name": "Cuesmes", "postalCode": "7033" },
              { "@type": "City", "name": "Frameries", "postalCode": "7080" },
              { "@type": "City", "name": "Quaregnon", "postalCode": "7390" },
              { "@type": "City", "name": "Boussu", "postalCode": "7300" },
              { "@type": "City", "name": "Saint-Ghislain", "postalCode": "7330" }
            ],
            "hasOfferCatalog": {
              "@type": "OfferCatalog",
              "name": "Catalogue Complet des Services de Plomberie et Dépannage Mons",
              "itemListElement": [
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Dépannage d'urgence fuite d'eau 24/7",
                    "description": "Intervention express en 20 à 30 minutes sur fuite de canalisation, tuyau percé, robinet cassé, vanne d'arrêt bloquée ou fuite de chasse d'eau encastrée.",
                    "url": "https://www.plombiermonsurgent.be/services/depannage-urgence",
                    "provider": { "@id": "https://www.plombiermonsurgent.be/#organization" }
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Débouchage haute pression de canalisation et WC",
                    "description": "Hydrocurage haute pression 350 bars et passage caméra sans destruction pour débouchage de WC, évier, baignoire, égout et colonne générale.",
                    "url": "https://www.plombiermonsurgent.be/services/debouchage",
                    "provider": { "@id": "https://www.plombiermonsurgent.be/#organization" }
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Recherche et détection de fuite non destructive",
                    "description": "Localisation millimétrique par caméra infrarouge, gaz traceur et sonde électro-acoustique sans casser les murs. Rapport agréé assurances fourni.",
                    "url": "https://www.plombiermonsurgent.be/services/detection-fuites",
                    "provider": { "@id": "https://www.plombiermonsurgent.be/#organization" }
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Dépannage de chaudière et entretien agréé PEB Wallonie",
                    "description": "Chauffagiste agréé CERGA pour dépannage de chaudière gaz et mazout toutes marques (Bulex, Vaillant, Viessmann) et attestation officielle de contrôle PEB.",
                    "url": "https://www.plombiermonsurgent.be/services/chauffage-chaudieres",
                    "provider": { "@id": "https://www.plombiermonsurgent.be/#organization" }
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Réparation, détartrage et remplacement de boiler",
                    "description": "Dépannage d'urgence sur absence d'eau chaude sanitaire, détartrage de cuve et résistance, remplacement de chauffe-eau électrique ou thermodynamique en 24h.",
                    "url": "https://www.plombiermonsurgent.be/services/chauffage-chaudieres",
                    "provider": { "@id": "https://www.plombiermonsurgent.be/#organization" }
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Installations sanitaires et rénovation de salle de bain",
                    "description": "Pose de WC suspendus Geberit, douches à l'italienne, robinetterie thermostatique Grohe/Hansgrohe et mise aux normes des réseaux sanitaires.",
                    "url": "https://www.plombiermonsurgent.be/services/installations-sanitaires",
                    "provider": { "@id": "https://www.plombiermonsurgent.be/#organization" }
                  }
                },
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "Service",
                    "name": "Adoucisseur d'eau anti-calcaire et filtration",
                    "description": "Installation, réglage et entretien d'adoucisseurs d'eau volumétriques BWT, EcoWater, Minimax pour protéger tuyauteries et appareils ménagers de la dureté montoise.",
                    "url": "https://www.plombiermonsurgent.be/services/traitement-eau",
                    "provider": { "@id": "https://www.plombiermonsurgent.be/#organization" }
                  }
                }
              ]
            }
          },
          {
            "@type": "WebSite",
            "@id": "https://www.plombiermonsurgent.be/#website",
            "url": "https://www.plombiermonsurgent.be",
            "name": "Plombier Mons Urgent",
            "description": "Dépannage plomberie d'urgence 24/7 en 20 à 30 minutes dans le Grand Mons et le Borinage.",
            "publisher": { "@id": "https://www.plombiermonsurgent.be/#organization" },
            "inLanguage": "fr-BE"
          }
        ]
      }
    </script>
  </head>
  <body>
    <Header currentPage={currentPage} />
    <main class="main-content">
      <slot />
    </main>
    <GuaranteesBanner />
    <GoogleMapSection />
    <Footer />
    <DesktopStickyCall />
    <WhatsAppChatWidget />
    <MobileStickyBar />
  </body>
</html>

<style>
  .main-content {
    padding-top: 104px;
  }
  @media (max-width: 991px) {
    .main-content {
      padding-top: 72px;
    }
  }
</style>
