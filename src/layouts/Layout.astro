---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import DesktopStickyCall from '../components/DesktopStickyCall.astro';
import WhatsAppChatWidget from '../components/WhatsAppChatWidget.astro';
import GuaranteesBanner from '../components/GuaranteesBanner.astro';
import GoogleMapSection from '../components/GoogleMapSection.astro';
import '../styles/global.css';
import criticalCss from '../styles/critical.css?raw';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  currentPage?: string;
}

const {
  title,
  description,
  canonicalPath = '',
  currentPage = 'accueil',
} = Astro.props;

const canonicalUrl = `https://plombier-mons-urgent.be${canonicalPath}`;
---

<!DOCTYPE html>
<html lang="fr-BE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    
    <!-- Critical CSS (Inlined for instant FCP and zero layout shift) -->
    <style is:inline set:html={criticalCss}></style>

    <!-- Favicon & Touch Icons (WebP & SVG Prioritized) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/webp" sizes="32x32" href="/favicon-32x32.webp" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/webp" sizes="16x16" href="/favicon-16x16.webp" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.webp" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Open Graph (WebP Format) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:site_name" content="Plombier Mons Urgent" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://plombier-mons-urgent.be/logo-512.webp" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://plombier-mons-urgent.be/logo-512.webp" />

    <!-- DNS Prefetch, Preconnect & Non-Blocking Font Loading (Core Web Vitals) -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@400;500;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@400;500;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@400;500;700;800&display=swap"
      />
    </noscript>

    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      />
    </noscript>

    <!-- LocalBusiness Schema JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Plumber",
        "name": "Plombier Mons Urgent",
        "legalName": "Plombier Mons Urgent SRL",
        "url": "https://plombier-mons-urgent.be",
        "logo": "https://plombier-mons-urgent.be/logo-512.webp",
        "image": "https://plombier-mons-urgent.be/logo-512.webp",
        "telephone": "+32489164378",
        "email": "contact@plombiermonsurgent.be",
        "hasMap": "https://maps.app.goo.gl/kYQARdAPhii8cHBj6",
        "priceRange": "€€",
        "foundingDate": "2009",
        "knowsAbout": [
          "Dépannage d'urgence 24/7 en 20 à 30 minutes",
          "Agréé CERGA Gaz N° 09-34821",
          "Attestation PEB Région Wallonne",
          "Assurance AXA Belgium Police N° 730.294.108",
          "Habilité Belgaqua eau potable",
          "Garantie décennale"
        ],
        "description": "Artisan plombier et chauffagiste d'urgence à Mons et dans le Borinage depuis 2009. Agréé CERGA & PEB, assuré AXA Belgium. Dépannage 24h/24 et 7j/7 en 20 à 30 minutes.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Rue du Fisch Club 31B",
          "addressLocality": "Mons",
          "postalCode": "7000",
          "addressRegion": "Hainaut",
          "addressCountry": "BE"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "50.4542",
          "longitude": "3.9567"
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
            "opens": "00:00",
            "closes": "23:59"
          }
        ],
        "areaServed": [
          { "@type": "City", "name": "Mons", "postalCode": "7000" },
          { "@type": "City", "name": "Ghlin", "postalCode": "7011" },
          { "@type": "City", "name": "Jemappes", "postalCode": "7012" },
          { "@type": "City", "name": "Flénu", "postalCode": "7012" },
          { "@type": "City", "name": "Nimy", "postalCode": "7020" },
          { "@type": "City", "name": "Maisières", "postalCode": "7020" },
          { "@type": "City", "name": "Havré", "postalCode": "7021" },
          { "@type": "City", "name": "Hyon", "postalCode": "7022" },
          { "@type": "City", "name": "Cuesmes", "postalCode": "7033" },
          { "@type": "City", "name": "Frameries", "postalCode": "7080" },
          { "@type": "City", "name": "Quaregnon", "postalCode": "7390" },
          { "@type": "City", "name": "Boussu", "postalCode": "7300" },
          { "@type": "City", "name": "Saint-Ghislain", "postalCode": "7330" }
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Services de plomberie et chauffage",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Dépannage d'urgence fuite d'eau"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Débouchage de canalisation et WC haute pression"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Entretien de chaudière agréé avec attestation PEB"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Dépannage et détartrage de boiler"
              }
            }
          ]
        }
      }
    </script>
  </head>
  <body>
    <Header currentPage={currentPage} />
    <main class="main-content">
      <slot />
    </main>
    <GuaranteesBanner />
    <GoogleMapSection />
    <Footer />
    <DesktopStickyCall />
    <WhatsAppChatWidget />
    <MobileStickyBar />
  </body>
</html>

<style>
  .main-content {
    padding-top: 104px;
  }
  @media (max-width: 991px) {
    .main-content {
      padding-top: 72px;
    }
  }
</style>
