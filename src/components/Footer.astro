---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-grid">
      <!-- Col 1: Brand & Presentation -->
      <div class="footer-col">
        <div class="footer-brand">
          <div class="brand-icon">
            <span class="material-symbols-outlined">plumbing</span>
          </div>
          <div>
            <span class="brand-title">PLOMBIER MONS URGENT</span>
            <span class="brand-sub">Artisan Plombier et Chauffagiste Agréé</span>
          </div>
        </div>
        <p class="footer-desc">
          Entreprise locale de plomberie, débouchage et dépannage de chauffage à Mons et dans le Borinage. Intervention rapide en 20 à 30 minutes, 24 heures sur 24 et 7 jours sur 7.
        </p>
        <div class="certif-pills">
          <div class="certif-item">
            <span class="material-symbols-outlined certif-icon">verified</span>
            <span>Agréé CERGA Gaz et Chauffage</span>
          </div>
          <div class="certif-item">
            <span class="material-symbols-outlined certif-icon">description</span>
            <span>Attestation PEB Région Wallonne</span>
          </div>
          <div class="certif-item">
            <span class="material-symbols-outlined certif-icon">shield_with_heart</span>
            <span>Agrément Assurance Habitation</span>
          </div>
        </div>
      </div>

      <!-- Col 2: Services Principaux -->
      <div class="footer-col">
        <h3 class="footer-heading">Services d'Urgence</h3>
        <ul class="footer-links">
          <li>
            <a href="/services#debouchage" class="footer-link">
              <span class="material-symbols-outlined link-arrow">chevron_right</span>
              <span>Débouchage WC et canalisations</span>
            </a>
          </li>
          <li>
            <a href="/services#fuites" class="footer-link">
              <span class="material-symbols-outlined link-arrow">chevron_right</span>
              <span>Recherche de fuite non destructive</span>
            </a>
          </li>
          <li>
            <a href="/services#chauffage" class="footer-link">
              <span class="material-symbols-outlined link-arrow">chevron_right</span>
              <span>Dépannage chaudière gaz et mazout</span>
            </a>
          </li>
          <li>
            <a href="/services#chauffage" class="footer-link">
              <span class="material-symbols-outlined link-arrow">chevron_right</span>
              <span>Entretien annuel avec attestation PEB</span>
            </a>
          </li>
          <li>
            <a href="/services#boiler" class="footer-link">
              <span class="material-symbols-outlined link-arrow">chevron_right</span>
              <span>Détartrage et pose de chauffe-eau</span>
            </a>
          </li>
          <li>
            <a href="/services#adoucisseur" class="footer-link">
              <span class="material-symbols-outlined link-arrow">chevron_right</span>
              <span>Installation d'adoucisseur d'eau</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Zones d'Intervention -->
      <div class="footer-col">
        <h3 class="footer-heading">Grand Mons et Borinage</h3>
        <ul class="footer-links">
          <li>
            <a href="/locations" class="footer-link">
              <span class="material-symbols-outlined link-arrow">location_on</span>
              <span>Mons-Centre (7000)</span>
            </a>
          </li>
          <li>
            <a href="/locations" class="footer-link">
              <span class="material-symbols-outlined link-arrow">location_on</span>
              <span>Ghlin (7011)</span>
            </a>
          </li>
          <li>
            <a href="/locations" class="footer-link">
              <span class="material-symbols-outlined link-arrow">location_on</span>
              <span>Jemappes et Flénu (7012)</span>
            </a>
          </li>
          <li>
            <a href="/locations" class="footer-link">
              <span class="material-symbols-outlined link-arrow">location_on</span>
              <span>Cuesmes (7033)</span>
            </a>
          </li>
          <li>
            <a href="/locations" class="footer-link">
              <span class="material-symbols-outlined link-arrow">location_on</span>
              <span>Nimy et Maisières / SHAPE (7020)</span>
            </a>
          </li>
          <li>
            <a href="/locations" class="footer-link">
              <span class="material-symbols-outlined link-arrow">location_on</span>
              <span>Frameries, Quaregnon et Boussu</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Contact & Permanence -->
      <div class="footer-col">
        <h3 class="footer-heading">Contact Direct 24/7</h3>
        <div class="footer-contact-items">
          <div class="contact-box">
            <span class="material-symbols-outlined contact-icon">phone_in_talk</span>
            <div>
              <span class="contact-label">Ligne d'Urgence Immédiate</span>
              <a href="tel:065700387" class="contact-val">065 70 03 87</a>
            </div>
          </div>
          <div class="contact-box">
            <span class="material-symbols-outlined contact-icon">chat</span>
            <div>
              <span class="contact-label">Messagerie WhatsApp</span>
              <a href="https://wa.me/32470123456" class="contact-val" target="_blank" rel="noopener noreferrer">Envoyer photo / vidéo</a>
            </div>
          </div>
          <div class="contact-box">
            <span class="material-symbols-outlined contact-icon">pin_drop</span>
            <div>
              <span class="contact-label">Atelier et Dispatching</span>
              <span class="contact-val-static">Grand'Place et Avenue Frère Orban, 7000 Mons</span>
            </div>
          </div>
          <div class="contact-box">
            <span class="material-symbols-outlined contact-icon">schedule</span>
            <div>
              <span class="contact-label">Heures d'ouverture</span>
              <span class="contact-val-static">7j/7 et 24h/24 sans interruption</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="legal-info">
        <span>(c) {currentYear} Plombier Mons Urgent SRL. Tous droits réservés.</span>
        <span>Numéro BCE : BE 0794.812.940</span>
        <span>TVA 6% applicable sur les logements de plus de 10 ans</span>
      </div>
      <div class="legal-links">
        <a href="/about">À propos</a>
        <span>•</span>
        <a href="/services">Tarifs & Devis</a>
        <span>•</span>
        <a href="/contact">Plan d'accès</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--secondary);
    color: #ffffff;
    padding-top: 4.5rem;
    padding-bottom: 5.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 768px) {
    .site-footer {
      padding-bottom: 3rem;
    }
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
      gap: 2rem;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .brand-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background-color: var(--primary-container);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-title {
    display: block;
    font-size: 1.1rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .brand-sub {
    display: block;
    font-family: var(--font-inter);
    font-size: 0.72rem;
    color: var(--primary-fixed);
    text-transform: uppercase;
    font-weight: 700;
  }

  .footer-desc {
    font-size: 0.9rem;
    color: var(--surface-container-high);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .certif-pills {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .certif-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(255, 255, 255, 0.07);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-md);
    font-family: var(--font-inter);
    font-size: 0.78rem;
    color: var(--surface-container-lowest);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .certif-icon {
    font-size: 16px;
    color: var(--primary-fixed);
  }

  .footer-heading {
    font-family: var(--font-inter);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #ffffff;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--surface-container-high);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .footer-link:hover {
    color: var(--primary-fixed);
    transform: translateX(3px);
  }

  .link-arrow {
    font-size: 16px;
    color: var(--primary-fixed);
  }

  .footer-contact-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-box {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .contact-icon {
    font-size: 20px;
    color: var(--primary-fixed);
    margin-top: 0.15rem;
  }

  .contact-label {
    display: block;
    font-family: var(--font-inter);
    font-size: 0.75rem;
    color: var(--surface-container-highest);
  }

  .contact-val {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    transition: color 0.2s ease;
  }

  .contact-val:hover {
    color: var(--primary-fixed);
  }

  .contact-val-static {
    display: block;
    font-size: 0.88rem;
    color: var(--surface-container-high);
  }

  .footer-bottom {
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.82rem;
    color: var(--surface-container-high);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .legal-info {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .legal-links a:hover {
    color: var(--primary-fixed);
  }
</style>
