---
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-primary text-white pt-16 pb-24 md:pb-12 border-t border-primary-container">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-white/10">
      <!-- Col 1: Brand & NAP -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-primary-container flex items-center justify-center text-white">
            <span class="material-symbols-outlined text-[24px]">plumbing</span>
          </div>
          <div>
            <span class="font-headline-sm text-xl text-white font-extrabold tracking-tight">PLOMBIER MONS URGENT</span>
            <p class="text-xs text-on-primary-container">Artisans Dépanneurs Agréés Région Wallonne</p>
          </div>
        </div>
        <p class="text-sm text-surface-dim leading-relaxed max-w-md">
          Service d'urgence plomberie et débouchage intervenant 24h/24 et 7j/7 dans toute la région de Mons et du Borinage. Entreprise locale enregistrée, devis transparent systématique et matériel d'inspection haute précision.
        </p>
        <div class="pt-2 space-y-2 text-sm text-surface-dim">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px] text-primary-fixed">location_on</span>
            <span>Rue de la Chaussée 42, 7000 Mons, Belgique</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px] text-primary-fixed">call</span>
            <a href="tel:+3265794020" class="hover:text-white transition-colors">065 / 79 40 20</a>
            <span>•</span>
            <a href="tel:+32470552020" class="text-tertiary-fixed font-bold hover:underline">0470 / 55 20 20 (GSM Urgence)</a>
          </div>
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px] text-primary-fixed">verified</span>
            <span>N° BCE / TVA : <strong>BE 0842.195.834</strong></span>
          </div>
        </div>
      </div>

      <!-- Col 2: Services Silos -->
      <div class="space-y-3">
        <h3 class="font-headline-sm text-base font-bold text-white uppercase tracking-wider">Nos Services</h3>
        <ul class="space-y-2 text-sm text-surface-dim">
          <li><a href="/services/depannage-urgence" class="hover:text-primary-fixed transition-colors">Dépannage d'Urgence 24h/24</a></li>
          <li><a href="/services/debouchage" class="hover:text-primary-fixed transition-colors">Débouchage WC & Égouts</a></li>
          <li><a href="/services/detection-fuites" class="hover:text-primary-fixed transition-colors">Détection de Fuites d'Eau</a></li>
          <li><a href="/services/chauffage-chaudieres" class="hover:text-primary-fixed transition-colors">Chauffage & Chaudières Gaz CERGA</a></li>
          <li><a href="/services/installations-sanitaires" class="hover:text-primary-fixed transition-colors">Installations Sanitaires & SDB</a></li>
          <li><a href="/services/traitement-eau" class="hover:text-primary-fixed transition-colors">Adoucisseurs & Traitement d'Eau</a></li>
        </ul>

      </div>

      <!-- Col 3: Zones Grand Mons -->
      <div class="space-y-3">
        <h3 class="font-headline-sm text-base font-bold text-white uppercase tracking-wider">Zones d'Intervention</h3>
        <ul class="space-y-2 text-sm text-surface-dim">
          <li><a href="/locations#mons" class="hover:text-primary-fixed transition-colors">7000 Mons Centre</a></li>
          <li><a href="/locations#ghlin" class="hover:text-primary-fixed transition-colors">7011 Ghlin</a></li>
          <li><a href="/locations#jemappes" class="hover:text-primary-fixed transition-colors">7012 Jemappes & Flénu</a></li>
          <li><a href="/locations#cuesmes" class="hover:text-primary-fixed transition-colors">7033 Cuesmes</a></li>
          <li><a href="/locations#hyon" class="hover:text-primary-fixed transition-colors">7022 Hyon & Mesvin</a></li>
          <li><a href="/locations#frameries" class="hover:text-primary-fixed transition-colors">7080 Frameries & Borinage</a></li>
        </ul>
      </div>

      <!-- Col 4: Garanties & Agréments -->
      <div class="space-y-3">
        <h3 class="font-headline-sm text-base font-bold text-white uppercase tracking-wider">Garanties & Confiance</h3>
        <div class="flex flex-col gap-2.5 text-xs text-surface-dim">
          <div class="p-2.5 rounded-lg bg-surface-container/10 border border-white/10 flex items-center gap-2">
            <span class="material-symbols-outlined text-tertiary-fixed text-[20px]">shield</span>
            <span>Garantie 2 ans pièces & main-d'œuvre</span>
          </div>
          <div class="p-2.5 rounded-lg bg-surface-container/10 border border-white/10 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary-fixed text-[20px]">percent</span>
            <span>TVA réduite à 6 % (logements &gt; 10 ans)</span>
          </div>
          <div class="p-2.5 rounded-lg bg-surface-container/10 border border-white/10 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary-fixed text-[20px]">receipt_long</span>
            <span>Dossier technique agréé assurances belges</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-surface-dim">
      <p>© {currentYear} Plombier Mons Urgent SRL. Tous droits réservés. Agréé Wallonie & CERGA.</p>
      <div class="flex items-center gap-6">
        <a href="/about" class="hover:text-white transition-colors">À Propos</a>
        <a href="/contact" class="hover:text-white transition-colors">Contact</a>
        <a href="/services" class="hover:text-white transition-colors">Tarifs & Devis</a>
      </div>
    </div>
  </div>
</footer>
