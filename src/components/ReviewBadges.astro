---
export interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

const badges = [
  {
    platform: "Google Reviews",
    rating: "4.9 / 5",
    stars: 5,
    count: "+184 avis vérifiés",
    subtitle: "Artisan Plombier Mons",
    iconBg: "bg-white",
    badgeType: "google"
  },
  {
    platform: "Avis Vérifiés",
    rating: "9.8 / 10",
    stars: 5,
    count: "Score d'Excellence",
    subtitle: "Dépannage Rapide 24/7",
    iconBg: "bg-emerald-50",
    badgeType: "verified"
  },
  {
    platform: "Pages d'Or Belgique",
    rating: "Certifié",
    stars: 5,
    count: "Profil Contrôlé",
    subtitle: "Plomberie & Chauffage Mons",
    iconBg: "bg-amber-50",
    badgeType: "pagesdor"
  },
  {
    platform: "Recommandations Facebook",
    rating: "99 %",
    stars: 5,
    count: "Recommandé à Mons",
    subtitle: "Communauté Borinage",
    iconBg: "bg-blue-50",
    badgeType: "facebook"
  }
];
---

<div class={`w-full bg-surface-container-low py-8 border-y border-primary/10 ${className}`}>
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-6">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-primary-container text-white flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[24px]">grade</span>
        </div>
        <div>
          <h3 class="font-headline-sm text-base md:text-lg font-bold text-primary">
            Avis & Évaluations Certifiés sur le Grand Mons
          </h3>
          <p class="text-xs text-on-surface-variant">
            Retours d'expérience réels de clients résidant à Mons, Jemappes, Ghlin, Cuesmes, Nimy et Frameries.
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2 text-xs font-bold text-primary bg-surface-container-lowest px-3 py-1.5 rounded-full border border-primary/10">
        <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
        <span>Note Globale Moyenne : 4.9 / 5 (300+ interventions notées)</span>
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {badges.map((b) => (
        <div class="p-4 rounded-xl bg-surface-container-lowest border border-primary/10 shadow-sm hover:border-primary-container/40 hover:-translate-y-0.5 transition-all flex items-center gap-3.5">
          <!-- Logo / Icon representation -->
          <div class={`w-11 h-11 rounded-lg ${b.iconBg} border border-primary/10 flex items-center justify-center shrink-0`}>
            {b.badgeType === 'google' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.26v3.15C3.25 21.37 7.31 24 12 24z"/>
                <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.26C.46 8.16 0 9.94 0 12c0 2.06.46 3.84 1.26 5.42l4.02-3.15z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.25 2.63 1.26 6.58l4.02 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
              </svg>
            )}
            {b.badgeType === 'verified' && (
              <span class="material-symbols-outlined text-emerald-600 text-[24px]">verified</span>
            )}
            {b.badgeType === 'pagesdor' && (
              <span class="material-symbols-outlined text-amber-600 text-[24px]">menu_book</span>
            )}
            {b.badgeType === 'facebook' && (
              <svg class="w-5 h-5 fill-[#1877F2]" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            )}
          </div>

          <!-- Rating Details -->
          <div class="min-w-0">
            <div class="flex items-center gap-1.5">
              <span class="font-extrabold text-sm md:text-base text-primary leading-tight">{b.rating}</span>
              <div class="flex text-amber-400 text-xs">
                {'★'.repeat(b.stars)}
              </div>
            </div>
            <span class="text-xs font-bold text-on-surface block truncate">{b.platform}</span>
            <span class="text-[11px] text-secondary block truncate">{b.count}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
