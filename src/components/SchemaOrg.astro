---
export interface Props {
  pageType?: 'website' | 'service' | 'local' | 'article';
  pageTitle?: string;
  pageDescription?: string;
  pageUrl?: string;
  serviceData?: {
    name: string;
    description: string;
    serviceType: string;
    priceStartingAt?: string;
  };
}

const {
  pageType = 'website',
  pageTitle = "Plombier Mons Urgent | Dépannage 24/7 & Débouchage en 30 Min",
  pageDescription = "Plombier certifié à Mons et dans le Borinage. Dépannage plomberie d'urgence 24h/24, fuites d'eau, débouchage sterput/WC, boiler, chaudière gaz CERGA. Arrivée en 30 min.",
  pageUrl = "https://www.plombiermonsurgent.be/",
  serviceData
} = Astro.props;

// Ensure clean URL without trailing slash except root
const cleanUrl = pageUrl === 'https://www.plombiermonsurgent.be' || pageUrl === 'https://www.plombiermonsurgent.be/' 
  ? 'https://www.plombiermonsurgent.be/' 
  : pageUrl.replace(/\/+$/, '');

// Generate dynamic breadcrumb items
const urlObj = new URL(cleanUrl);
const pathSegments = urlObj.pathname.split('/').filter(Boolean);

const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Accueil",
    "item": "https://www.plombiermonsurgent.be/"
  }
];

if (pathSegments.length === 1) {
  const segmentNames: Record<string, string> = {
    'services': 'Services de Plomberie',
    'locations': "Zones d'Intervention",
    'blog': 'Guides & Conseils',
    'about': 'À Propos',
    'contact': 'Contact & Urgence'
  };
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 2,
    "name": segmentNames[pathSegments[0]] || pageTitle,
    "item": cleanUrl
  });
} else if (pathSegments.length >= 2) {
  const sectionParents: Record<string, { name: string; url: string }> = {
    'services': { name: 'Services de Plomberie', url: 'https://www.plombiermonsurgent.be/services' },
    'locations': { name: "Zones d'Intervention", url: 'https://www.plombiermonsurgent.be/locations' },
    'blog': { name: 'Guides & Conseils', url: 'https://www.plombiermonsurgent.be/blog' }
  };

  const parent = sectionParents[pathSegments[0]];
  if (parent) {
    breadcrumbItems.push({
      "@type": "ListItem",
      "position": 2,
      "name": parent.name,
      "item": parent.url
    });
    breadcrumbItems.push({
      "@type": "ListItem",
      "position": 3,
      "name": pageTitle,
      "item": cleanUrl
    });
  } else {
    breadcrumbItems.push({
      "@type": "ListItem",
      "position": 2,
      "name": pageTitle,
      "item": cleanUrl
    });
  }
}

