---
---

<section class="w-full bg-secondary-container py-5 border-y border-primary/10">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3.5">
      <!-- 1. Response Time -->
      <div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-lowest shadow-sm border border-primary/10">
        <div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center text-tertiary-container shrink-0">
          <span class="material-symbols-outlined text-[22px]">alarm_on</span>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="font-headline-sm text-xs md:text-sm text-primary font-bold leading-tight truncate">30–45 Min Chrono</span>
          <span class="font-body-sm text-[11px] text-secondary truncate">Urgence 24h/7 Mons & Borinage</span>
        </div>
      </div>

      <!-- 2. Years in Business -->
      <div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-lowest shadow-sm border border-primary/10">
        <div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center text-primary-container shrink-0">
          <span class="material-symbols-outlined text-[22px]">history</span>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="font-headline-sm text-xs md:text-sm text-primary font-bold leading-tight truncate">15+ Ans d'Expérience</span>
          <span class="font-body-sm text-[11px] text-secondary truncate">Depuis 2011 • 4.9/5 Google</span>
        </div>
      </div>

      <!-- 3. All Certifications -->
      <div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-lowest shadow-sm border border-primary/10">
        <div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center text-primary-container shrink-0">
          <span class="material-symbols-outlined text-[22px]">verified</span>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="font-headline-sm text-xs md:text-sm text-primary font-bold leading-tight truncate">Toutes Certifications</span>
          <span class="font-body-sm text-[11px] text-secondary truncate">Agréé CERGA & Wallonie G1/G2</span>
        </div>
      </div>

      <!-- 4. Insurance Information -->
      <div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-lowest shadow-sm border border-primary/10">
        <div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center text-primary-container shrink-0">
          <span class="material-symbols-outlined text-[22px]">policy</span>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="font-headline-sm text-xs md:text-sm text-primary font-bold leading-tight truncate">Assurances Agréées</span>
          <span class="font-body-sm text-[11px] text-secondary truncate">RC Pro & Décennale AXA/Ethias</span>
        </div>
      </div>

      <!-- 5. Guarantees -->
      <div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-lowest shadow-sm border border-primary/10 col-span-2 md:col-span-1">
        <div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center text-primary-container shrink-0">
          <span class="material-symbols-outlined text-[22px]">shield</span>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="font-headline-sm text-xs md:text-sm text-primary font-bold leading-tight truncate">Garantie 2 à 10 Ans</span>
          <span class="font-body-sm text-[11px] text-secondary truncate">Devis clair + TVA 6% légale</span>
        </div>
      </div>
    </div>
  </div>
</section>
