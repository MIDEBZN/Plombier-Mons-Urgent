---
const whatsappNumber = "32470552020";
const defaultMessage = encodeURIComponent("Bonjour, j'ai besoin d'une intervention plomberie urgente à Mons.");
---

<div id="whatsapp-widget-container" class="fixed z-50 right-4 bottom-20 md:bottom-6 md:right-6 font-sans">
  <!-- 1. Expanded WhatsApp Chat Window -->
  <div
    id="whatsapp-chat-box"
    class="hidden mb-4 w-[320px] sm:w-[350px] bg-white rounded-2xl shadow-2xl border border-primary/10 overflow-hidden transform transition-all duration-300 origin-bottom-right"
  >
    <!-- Chat Header -->
    <div class="bg-[#075E54] text-white p-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="relative">
          <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-white font-bold text-sm">
            <span class="material-symbols-outlined text-[24px]">plumbing</span>
          </div>
          <span class="absolute bottom-0 right-0 w-3 h-3 bg-[#25D366] border-2 border-[#075E54] rounded-full"></span>
        </div>
        <div>
          <h4 class="font-bold text-sm leading-tight text-white">Plombier Mons Urgent</h4>
          <p class="text-[11px] text-white/80 flex items-center gap-1">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#25D366] animate-pulse"></span>
            <span>Dépanneur d'astreinte en ligne</span>
          </p>
        </div>
      </div>
      <button
        id="close-whatsapp-chat"
        type="button"
        class="text-white/80 hover:text-white p-1 rounded-full hover:bg-white/10 transition-colors"
        aria-label="Fermer le chat"
      >
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <!-- Chat Body (WhatsApp chat pattern) -->
    <div class="p-4 bg-[#EFEAE2] space-y-3 max-h-[320px] overflow-y-auto" style="background-image: radial-gradient(#d4cfc6 1px, transparent 1px); background-size: 16px 16px;">
      <div class="bg-white p-3 rounded-2xl rounded-tl-none shadow-sm text-xs text-neutral-800 space-y-1 max-w-[88%]">
        <p class="font-bold text-primary text-[11px]">Artisan de garde • Mons</p>
        <p class="leading-relaxed">
          Bonjour ! 👋 Avez-vous une urgence plomberie ou débouchage à Mons ?
        </p>
        <p class="text-[10px] text-neutral-400 text-right">À l'instant</p>
      </div>

      <div class="space-y-1.5 pt-1">
        <p class="text-[11px] font-bold text-neutral-600 px-1">Sélectionnez votre cas :</p>
        <div class="flex flex-col gap-1.5">
          <a
            href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Bonjour, j'ai une FUITE D'EAU urgente à Mons.")}`}
            target="_blank"
            rel="noopener"
            class="block p-2 rounded-xl bg-white hover:bg-[#DCF8C6] border border-neutral-200 text-xs font-semibold text-neutral-800 transition-colors shadow-2xl hover:shadow"
          >
            🚨 Fuite d'eau abondante / Inondation
          </a>
          <a
            href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Bonjour, j'ai un WC ou une canalisation bouchée à Mons.")}`}
            target="_blank"
            rel="noopener"
            class="block p-2 rounded-xl bg-white hover:bg-[#DCF8C6] border border-neutral-200 text-xs font-semibold text-neutral-800 transition-colors shadow-2xl hover:shadow"
          >
            🚽 WC ou égout bouché / Refoulement
          </a>
          <a
            href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Bonjour, ma chaudière ou mon boiler est en panne à Mons.")}`}
            target="_blank"
            rel="noopener"
            class="block p-2 rounded-xl bg-white hover:bg-[#DCF8C6] border border-neutral-200 text-xs font-semibold text-neutral-800 transition-colors shadow-2xl hover:shadow"
          >
            🔥 Panne de chaudière / Plus d'eau chaude
          </a>
          <a
            href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Bonjour, je souhaite un devis gratuit pour des travaux de plomberie à Mons.")}`}
            target="_blank"
            rel="noopener"
            class="block p-2 rounded-xl bg-white hover:bg-[#DCF8C6] border border-neutral-200 text-xs font-semibold text-neutral-800 transition-colors shadow-2xl hover:shadow"
          >
            💬 Autre demande / Devis gratuit
          </a>
        </div>
      </div>
    </div>

    <!-- Chat Footer -->
    <div class="p-3 bg-white border-t border-neutral-200">
      <a
        href={`https://wa.me/${whatsappNumber}?text=${defaultMessage}`}
        target="_blank"
        rel="noopener"
        class="w-full py-2.5 px-4 rounded-xl bg-[#25D366] hover:bg-[#1EBE5D] text-white font-bold text-xs shadow-md transition-all flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.073-2.126-.519-1.829-.757-3.003-2.612-3.094-2.734-.09-.122-.745-.992-.745-1.892 0-.9.467-1.344.633-1.527.167-.183.366-.228.489-.228.122 0 .245.002.352.007.113.005.263-.042.412.316.155.373.53 1.296.577 1.391.047.095.078.207.016.331-.063.125-.094.202-.187.311-.093.11-.197.246-.281.331-.094.095-.192.198-.083.385.109.188.486.802 1.042 1.298.718.641 1.324.841 1.512.934.188.093.298.078.409-.047.11-.125.474-.551.6-.74.126-.188.252-.157.423-.094s1.087.513 1.275.607c.188.094.313.141.36.22.047.078.047.453-.097.858z"/>
        </svg>
        <span>Ouvrir WhatsApp en Direct</span>
      </a>
    </div>
  </div>

  <!-- 2. Floating Circular WhatsApp Launcher Button -->
  <div class="relative flex items-center justify-end">
    <!-- Tooltip badge (desktop only) -->
    <div
      id="whatsapp-tooltip"
      class="hidden md:flex items-center gap-2 mr-3 px-3 py-1.5 rounded-full bg-white text-primary text-xs font-bold shadow-lg border border-primary/10 animate-bounce cursor-pointer"
    >
      <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
      <span>Besoin d'aide ? En ligne 24h/7</span>
    </div>

    <button
      id="toggle-whatsapp-widget"
      type="button"
      class="w-14 h-14 rounded-full bg-[#25D366] text-white shadow-xl hover:bg-[#1EBE5D] hover:scale-105 active:scale-95 transition-all flex items-center justify-center relative focus:outline-none cursor-pointer"
      aria-label="Discuter sur WhatsApp"
    >
      <!-- Ping effect -->
      <span class="absolute -top-1 -right-1 flex h-4 w-4">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#25D366] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-4 w-4 bg-[#075E54] text-white text-[9px] font-extrabold items-center justify-center">1</span>
      </span>

      <!-- WhatsApp SVG Icon -->
      <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.073-2.126-.519-1.829-.757-3.003-2.612-3.094-2.734-.09-.122-.745-.992-.745-1.892 0-.9.467-1.344.633-1.527.167-.183.366-.228.489-.228.122 0 .245.002.352.007.113.005.263-.042.412.316.155.373.53 1.296.577 1.391.047.095.078.207.016.331-.063.125-.094.202-.187.311-.093.11-.197.246-.281.331-.094.095-.192.198-.083.385.109.188.486.802 1.042 1.298.718.641 1.324.841 1.512.934.188.093.298.078.409-.047.11-.125.474-.551.6-.74.126-.188.252-.157.423-.094s1.087.513 1.275.607c.188.094.313.141.36.22.047.078.047.453-.097.858z"/>
      </svg>
    </button>
  </div>
</div>

<script>
  const toggleBtn = document.getElementById('toggle-whatsapp-widget');
  const chatBox = document.getElementById('whatsapp-chat-box');
  const closeBtn = document.getElementById('close-whatsapp-chat');
  const tooltip = document.getElementById('whatsapp-tooltip');

  function openChat() {
    if (chatBox) {
      chatBox.classList.remove('hidden');
      if (tooltip) tooltip.classList.add('hidden');
    }
  }

  function closeChat() {
    if (chatBox) {
      chatBox.classList.add('hidden');
    }
  }

  if (toggleBtn && chatBox) {
    toggleBtn.addEventListener('click', () => {
      if (chatBox.classList.contains('hidden')) {
        openChat();
      } else {
        closeChat();
      }
    });
  }

  if (tooltip) {
    tooltip.addEventListener('click', openChat);
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeChat();
    });
  }

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && chatBox && !chatBox.classList.contains('hidden')) {
      closeChat();
    }
  });
</script>
