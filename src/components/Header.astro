---
interface Props {
  currentPage?: string;
}

const { currentPage = 'accueil' } = Astro.props;

const navItems = [
  { label: 'Accueil', href: '/', id: 'accueil' },
  { label: 'Services', href: '/services', id: 'services' },
  { label: 'Zones d\'intervention', href: '/locations', id: 'locations' },
  { label: 'À propos', href: '/about', id: 'about' },
  { label: 'Contact', href: '/contact', id: 'contact' },
];
---

<header class="site-header">
  <!-- Top Trust & Credentials Bar -->
  <div class="top-trust-bar" style="background: var(--color-navy-dark, #0B1728); color: #94A3B8; font-size: 0.75rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding: 0.35rem 0;">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
      <div style="display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;">
        <span style="display: flex; align-items: center; gap: 0.35rem; color: #E2E8F0;">
          <span class="material-symbols-outlined" style="font-size: 14px; color: var(--color-teal);">verified</span>
          <strong>15+ ans d'expérience</strong> (Fondé en 2009)
        </span>
        <span style="display: flex; align-items: center; gap: 0.35rem; color: #CBD5E1;">
          <span class="material-symbols-outlined" style="font-size: 14px; color: var(--color-teal);">workspace_premium</span>
          Agréé CERGA Gaz & PEB Wallonie
        </span>
        <span style="display: flex; align-items: center; gap: 0.35rem; color: #CBD5E1;">
          <span class="material-symbols-outlined" style="font-size: 14px; color: var(--color-teal);">shield</span>
          Assurance Décennale AXA Belgium
        </span>
      </div>
      <div style="display: flex; align-items: center; gap: 1rem;">
        <span style="display: flex; align-items: center; gap: 0.35rem; color: #FCA5A5;">
          <span class="material-symbols-outlined" style="font-size: 14px; color: var(--color-alert);">timer</span>
          Arrivée garantie en 20 à 30 min
        </span>
        <span style="color: #64748B;">|</span>
        <span style="color: #E2E8F0; font-weight: 600;">Devis 100% ferme avant travaux</span>
      </div>
    </div>
  </div>

  <div class="container header-container">
    <!-- Brand Logo -->
    <a href="/" class="brand-link" aria-label="Plombier Mons Urgent - Accueil">
      <div class="brand-icon">
        <span class="material-symbols-outlined icon-display">plumbing</span>
      </div>
      <div class="brand-text">
        <span class="brand-name">PLOMBIER MONS URGENT</span>
        <span class="brand-sub">Artisan Dépannage 24/7 Hainaut</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Navigation principale">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { 'active': currentPage === item.id }]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- Live Status Pill (Desktop) -->
      <div class="status-pill">
        <span class="pulse-dot teal"></span>
        <span class="status-text">Disponible • Arrivée en 20-30 min</span>
      </div>

      <!-- Emergency Call Button -->
      <a href="tel:065700387" class="btn-primary call-btn">
        <span class="material-symbols-outlined">phone_in_talk</span>
        <span>065 70 03 87</span>
      </a>

      <!-- Mobile Menu Trigger -->
      <button
        id="mobile-menu-toggle"
        class="mobile-toggle"
        aria-label="Ouvrir le menu de navigation"
        aria-expanded="false"
      >
        <span class="material-symbols-outlined" id="menu-icon-bars">menu</span>
        <span class="material-symbols-outlined hide" id="menu-icon-close">close</span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-drawer" class="mobile-drawer hide">
    <div class="container mobile-drawer-inner">
      <div class="mobile-status-banner">
        <span class="pulse-dot"></span>
        <span>Permanence 24h/24 et 7j/7 dans tout le Grand Mons</span>
      </div>
      <nav class="mobile-nav-links">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={['mobile-nav-link', { 'active': currentPage === item.id }]}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="mobile-drawer-cta">
        <a href="tel:065700387" class="btn-tertiary w-full">
          <span class="material-symbols-outlined">call</span>
          <span>Appeler le 065 70 03 87</span>
        </a>
        <a href="https://wa.me/32470123456" class="btn-secondary w-full" target="_blank" rel="noopener noreferrer">
          <span class="material-symbols-outlined text-teal">chat</span>
          <span>WhatsApp Direct</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 80px;
    background-color: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--outline-variant);
    box-shadow: 0 2px 12px rgba(12, 29, 42, 0.04);
  }

  .header-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--on-surface);
  }

  .brand-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    background-color: var(--primary-container);
    color: var(--on-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(0, 128, 128, 0.25);
  }

  .icon-display {
    font-size: 26px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--secondary);
    line-height: 1.2;
  }

  .brand-sub {
    font-family: var(--font-inter);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--primary-container);
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 1.75rem;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: flex;
    }
  }

  .nav-link {
    font-family: var(--font-inter);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--on-surface-variant);
    transition: color 0.2s ease;
    padding: 0.5rem 0;
    position: relative;
  }

  .nav-link:hover {
    color: var(--primary-container);
  }

  .nav-link.active {
    color: var(--primary-container);
    font-weight: 700;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--primary-container);
    border-radius: 2px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .status-pill {
    display: none;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--surface-container-low);
    border: 1px solid rgba(0, 128, 128, 0.2);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
  }

  @media (min-width: 1200px) {
    .status-pill {
      display: inline-flex;
    }
  }

  .status-text {
    font-family: var(--font-inter);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--on-surface-variant);
  }

  .call-btn {
    padding: 0.65rem 1.15rem;
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .call-btn {
      display: none;
    }
  }

  .mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
    background-color: var(--surface-container-low);
    border: 1px solid var(--outline-variant);
    color: var(--on-surface);
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .mobile-toggle {
      display: none;
    }
  }

  .mobile-drawer {
    background-color: #ffffff;
    border-bottom: 1px solid var(--outline-variant);
    box-shadow: var(--shadow-lg);
    padding-bottom: 1.5rem;
  }

  .mobile-drawer.hide {
    display: none;
  }

  .mobile-drawer-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1rem;
  }

  .mobile-status-banner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.85rem;
    background-color: var(--surface-container-low);
    border-radius: var(--radius-md);
    font-family: var(--font-inter);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--on-surface);
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    padding: 0.75rem 0.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    color: var(--on-surface);
    transition: background-color 0.2s ease;
  }

  .mobile-nav-link:hover, .mobile-nav-link.active {
    background-color: var(--surface-container-low);
    color: var(--primary-container);
  }

  .mobile-drawer-cta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .w-full {
    width: 100%;
  }

  .text-teal {
    color: var(--primary-container);
  }

  .hide {
    display: none !important;
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const iconBars = document.getElementById('menu-icon-bars');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && drawer && iconBars && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = drawer.classList.contains('hide');
      if (isHidden) {
        drawer.classList.remove('hide');
        iconBars.classList.add('hide');
        iconClose.classList.remove('hide');
        toggleBtn.setAttribute('aria-expanded', 'true');
      } else {
        drawer.classList.add('hide');
        iconBars.classList.remove('hide');
        iconClose.classList.add('hide');
        toggleBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
