---
import Layout from '../../layouts/Layout.astro';
import TrustBar from '../../components/TrustBar.astro';
import QuoteForm from '../../components/QuoteForm.astro';

const includedItems = [
  { title: "Rénovation complète de salle de bain clé en main", desc: "Prise en charge de A à Z : démolition de l'ancienne salle de bain, plomberie multicouche neuve, étanchéité SPEC, carrelage et pose des équipements." },
  { title: "Installation de WC suspendus Geberit", desc: "Pose de bâti-support autoportant Geberit Duofix avec cuvette suspendue moderne sans bride Rimfree pour une hygiène irréprochable et un entretien facilité." },
  { title: "Création de douches à l'italienne sur-mesure", desc: "Receveurs extra-plats antidérapants ou receveurs prêts à carreler avec caniveau inox haut débit et parois vitrées de sécurité anticalcaire." },
  { title: "Pose de WC traditionnels au sol & Sanibroyeurs", desc: "Remplacement rapide de toilettes standards, mécanisme de chasse double flux 3/6L, ou broyeur sanitaire pour les pièces sans évacuation gros diamètre." },
  { title: "Installation de baignoires îlots & combinés bain-douche", desc: "Pose de baignoires modernes acryliques ou résine, baignoires d'angle, robinetterie sur pied ou encastrée avec vidage automatique." },
  { title: "Pose de meubles vasques simples & doubles", desc: "Montage et raccordement de meubles de salle de bain suspendus ou sur pieds, plans vasques céramique ou résine avec robinetterie assortie." },
  { title: "Remplacement de robinetterie haut de gamme", desc: "Installation de mitigeurs lavabo, bain et colonnes de douche thermostatiques Grohe et Hansgrohe avec sécurité anti-brûlure à 38°C." },
  { title: "Modification d'arrivées d'eau et évacuations PVC", desc: "Reprise des réseaux d'alimentation en multicouche serti sans soudure apparente et mise en pente optimale des décharges PVC d'évacuation." }
];

const commonProblems = [
  { title: "WC qui coule en continu / chasse défaillante", icon: "water_drop", desc: "Flotteur entartré, clapet de cloche usé ou mécanisme bloqué gaspillant jusqu'à 150 litres d'eau potable par jour." },
  { title: "Robinet mitigeur qui fuit ou crache du calcaire", icon: "valve", desc: "Cartouche céramique usée par l'eau dure de Mons ou aérateur moussier complètement bouché par le tartre." },
  { title: "Fuite sous l'évier, la vasque ou le receveur", icon: "warning", desc: "Joint d'étanchéité dégradé, raccord à visser desserré ou siphon en plastique fendu provoquant des infiltrations." },
  { title: "Manque de pression ou eau tiède sous la douche", icon: "speed", desc: "Colonne de douche thermostatique encrassée par les dépôts calcaires ou tuyauterie d'alimentation sous-dimensionnée." },
  { title: "Salle de bain vétuste ou joints noircis", icon: "bathtub", desc: "Moisissures derrière la faïence, carreaux qui sonnent creux ou disposition inadaptée aux personnes à mobilité réduite." },
  { title: "Mauvaises odeurs d'égout dans la pièce d'eau", icon: "air", desc: "Désiphonnage lors des vidanges, siphon sec ou absence de ventilation primaire sur la colonne d'évacuation." }
];

const faqs = [
  {
    q: "Combien coûte la rénovation d'une salle de bain à Mons ?",
    a: "Le budget d'une rénovation de salle de bain varie selon la surface et les prestations : comptez entre 4 500 € et 8 000 € pour une rénovation standard avec sanitaires neufs, et de 8 500 € à 14 000 € pour une transformation complète haut de gamme (douche à l'italienne, carrelage toute hauteur, WC suspendu et meuble double vasque). Un devis gratuit et détaillé est systématiquement établi après visite sur place."
  },
  {
    q: "Puis-je installer un WC suspendu en remplacement d'un WC au sol classique ?",
    a: "Absolument. Nos plombiers adaptent l'évacuation existante (sortie horizontale ou verticale au sol) à l'aide d'une pipe coudée spécifique et installent un bâti-support autoportant Geberit robuste, fixé au sol et au mur, prêt à être carrelé ou habillé d'un panneau étanche."
  },
  {
    q: "Quelles marques de sanitaires et de robinetterie posez-vous ?",
    a: "Nous privilégions exclusivement des marques professionnelles réputées pour leur longévité face à l'eau calcaire de Mons : Geberit pour les bâtis-supports et WC, Grohe et Hansgrohe pour la robinetterie thermostatique, Villeroy & Boch, Duravit et Ideal Standard pour les céramiques sanitaires."
  },
  {
    q: "Bénéficie-t-on du taux de TVA réduit à 6 % sur les travaux sanitaires ?",
    a: "Oui ! En Belgique, si votre maison ou appartement a plus de 10 ans et est affecté à un usage privé, vous bénéficiez du taux de TVA réduit à 6 % sur la main-d'œuvre et le matériel fourni et posé par notre entreprise agréée, contre 21 % de TVA ordinaire."
  },
  {
    q: "Combien de temps durent les travaux de rénovation de salle de bain ?",
    a: "Pour un remplacement ponctuel de sanitaires (WC suspendu, colonne de douche ou meuble vasque), l'intervention dure généralement 1/2 journée à 1 journée. Pour une rénovation complète de salle de bain clé en main, comptez généralement entre 5 et 8 jours ouvrés."
  }
];
---

<Layout
  title="Plombier Sanitaire Mons | Salle de Bain, WC Suspendu & Robinetterie"
  description="Plombier sanitaire qualifié à Mons. Rénovation complète de salle de bain, pose de WC suspendu Geberit, douches à l'italienne, vasques et robinetterie Grohe. Devis gratuit."
>
  <!-- Hero Section -->
  <section class="relative w-full bg-background overflow-hidden py-10 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-7 space-y-4 md:space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-container-high text-primary font-bold text-xs md:text-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-primary-container pulse-emergency"></span>
            <span>Artisan Plombier Sanitaire Agréé • TVA 6%</span>
          </div>

          <h1 class="font-display-hero text-3xl sm:text-4xl lg:text-5xl text-primary font-extrabold tracking-tight leading-tight">
            Installations Sanitaires & Rénovation Salle de Bain à Mons
          </h1>

          <p class="font-body-lg text-base md:text-lg text-on-surface-variant max-w-2xl leading-relaxed">
            Du simple remplacement d'un mitigeur défaillant à la <strong>création complète de votre salle de bain moderne</strong>, nos artisans plombiers réalisent vos travaux sanitaires avec des matériaux durables et des finitions soignées.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
            <div class="flex items-center gap-2.5 text-sm font-semibold text-on-surface">
              <span class="material-symbols-outlined text-primary-container text-[22px]">verified</span>
              <span>Marques de référence : Geberit, Grohe, Hansgrohe</span>
            </div>
            <div class="flex items-center gap-2.5 text-sm font-semibold text-on-surface">
              <span class="material-symbols-outlined text-primary-container text-[22px]">percent</span>
              <span>TVA réduite à 6 % (logement de plus de 10 ans)</span>
            </div>
            <div class="flex items-center gap-2.5 text-sm font-semibold text-on-surface">
              <span class="material-symbols-outlined text-primary-container text-[22px]">shield</span>
              <span>Garantie décennale et biennale sur les installations</span>
            </div>
            <div class="flex items-center gap-2.5 text-sm font-semibold text-on-surface">
              <span class="material-symbols-outlined text-primary-container text-[22px]">schedule</span>
              <span>Devis gratuit sous 24h & respect strict des délais</span>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-4 pt-3">
            <a
              href="tel:+3265794020"
              class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-lg bg-primary-container text-white font-bold text-base hover:bg-forest-dark shadow-md transition-all hover:-translate-y-0.5"
            >
              <span class="material-symbols-outlined text-[22px] text-tertiary-fixed">call</span>
              <span>Appeler le 065 / 79 40 20</span>
            </a>
            <a
              href="https://wa.me/32470552020?text=Bonjour,%20j'ai%20un%20projet%20de%20salle%20de%20bain%20ou%20plomberie%20sanitaire%20à%20Mons"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-lg bg-surface-container-high text-primary font-bold text-base hover:bg-surface-container-highest transition-all border border-primary/10"
            >
              <span class="material-symbols-outlined text-[22px] text-primary-container">chat</span>
              <span>Projet Sanitaire sur WhatsApp</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 w-full">
          <QuoteForm title="Projet Salle de Bain & Sanitaires" subtitle="Devis gratuit sans engagement à Mons et environs" />
        </div>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- What's Included -->
  <section class="w-full py-16 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Prestations Clé en Main</span>
        <h2 class="font-headline-xl text-2xl md:text-3xl text-primary font-extrabold mt-1">
          Tous nos travaux d'installations sanitaires à Mons
        </h2>
        <p class="text-sm md:text-base text-on-surface-variant mt-2">
          Nous concevons et modernisons vos pièces d'eau pour allier confort au quotidien, esthétique moderne et économies d'eau.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {includedItems.map((item, idx) => (
          <div class="p-5 rounded-xl bg-surface-container-lowest border border-primary/10 shadow-sm flex flex-col justify-between">
            <div>
              <div class="w-9 h-9 rounded-lg bg-primary-container text-white flex items-center justify-center font-bold text-xs mb-3">
                0{idx + 1}
              </div>
              <h3 class="font-headline-sm text-base text-primary font-bold">{item.title}</h3>
              <p class="text-xs text-on-surface-variant mt-2 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Common Problems We Solve -->
  <section class="w-full py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Dysfonctionnements Courants</span>
        <h2 class="font-headline-xl text-2xl md:text-3xl text-primary font-extrabold mt-1">
          Les problèmes de sanitaires et de plomberie que nous résolvons
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {commonProblems.map((prob) => (
          <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm card-hover-effect">
            <div class="w-12 h-12 rounded-xl bg-surface-container-high text-primary-container flex items-center justify-center mb-4">
              <span class="material-symbols-outlined text-[28px]">{prob.icon}</span>
            </div>
            <h3 class="font-headline-sm text-base text-primary font-bold">{prob.title}</h3>
            <p class="text-xs md:text-sm text-on-surface-variant mt-2 leading-relaxed">{prob.desc}</p>
            <div class="pt-4 mt-4 border-t border-primary/5 flex items-center justify-between">
              <a href="tel:+3265794020" class="text-xs font-bold text-primary-container hover:underline flex items-center gap-1">
                <span>Demander une réparation</span>
                <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Step-by-Step Process -->
  <section class="w-full py-16 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Méthodologie Pro</span>
        <h2 class="font-headline-xl text-2xl md:text-3xl text-primary font-extrabold mt-1">
          Notre processus de rénovation et d'installation sanitaire
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm relative overflow-hidden">
          <span class="text-6xl font-extrabold text-primary/5 absolute top-2 right-4">01</span>
          <div class="w-10 h-10 rounded-lg bg-primary-container text-white flex items-center justify-center font-bold text-base mb-4">1</div>
          <h3 class="font-headline-sm text-base text-primary font-bold">Visite Technique & Conseils</h3>
          <p class="text-xs text-on-surface-variant mt-2 leading-relaxed">
            Relevé précis des cotes, diagnostic des réseaux d'eau existants et écoute de vos envies de design et d'ergonomie.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm relative overflow-hidden">
          <span class="text-6xl font-extrabold text-primary/5 absolute top-2 right-4">02</span>
          <div class="w-10 h-10 rounded-lg bg-primary-container text-white flex items-center justify-center font-bold text-base mb-4">2</div>
          <h3 class="font-headline-sm text-base text-primary font-bold">Devis Clair & Chiffré</h3>
          <p class="text-xs text-on-surface-variant mt-2 leading-relaxed">
            Proposition détaillée poste par poste sans frais dissimulés, avec application de la TVA à 6% si applicable.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm relative overflow-hidden">
          <span class="text-6xl font-extrabold text-primary/5 absolute top-2 right-4">03</span>
          <div class="w-10 h-10 rounded-lg bg-primary-container text-white flex items-center justify-center font-bold text-base mb-4">3</div>
          <h3 class="font-headline-sm text-base text-primary font-bold">Réalisation dans les Règles de l'Art</h3>
          <p class="text-xs text-on-surface-variant mt-2 leading-relaxed">
            Dépose soignée, tuyauterie multicouche sertie, étanchéité hydrofuge sous carrelage et pose des sanitaires.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm relative overflow-hidden">
          <span class="text-6xl font-extrabold text-primary/5 absolute top-2 right-4">04</span>
          <div class="w-10 h-10 rounded-lg bg-primary-container text-white flex items-center justify-center font-bold text-base mb-4">4</div>
          <h3 class="font-headline-sm text-base text-primary font-bold">Mise en Eau & Réception</h3>
          <p class="text-xs text-on-surface-variant mt-2 leading-relaxed">
            Test de montée en pression, vérification des évacuations sans aucune fuite et nettoyage méticuleux du chantier.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="w-full py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 space-y-4">
          <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Excellence & Sérénité</span>
          <h2 class="font-headline-xl text-2xl md:text-3xl text-primary font-extrabold">
            Pourquoi confier vos travaux sanitaires à Plombier Mons Urgent ?
          </h2>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            Une fuite dans une salle de bain ou une étanchéité mal réalisée peut causer des dégâts des eaux majeurs. En faisant appel à nos artisans spécialisés, vous bénéficiez d'une garantie totale sur la qualité et la durabilité.
          </p>

          <div class="space-y-3 pt-2">
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary-container text-[22px] mt-0.5">verified_user</span>
              <div>
                <h4 class="text-sm font-bold text-primary">Matériaux premium certifiés</h4>
                <p class="text-xs text-on-surface-variant">Bâti-supports Geberit garantis 10 ans, robinetterie Grohe céramique et receveurs extra-plats antidérapants.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary-container text-[22px] mt-0.5">percent</span>
              <div>
                <h4 class="text-sm font-bold text-primary">Avantage fiscal TVA 6 % en Belgique</h4>
                <p class="text-xs text-on-surface-variant">Économisez 15 % sur la totalité du coût des travaux pour toute habitation privée de plus de 10 ans.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary-container text-[22px] mt-0.5">handyman</span>
              <div>
                <h4 class="text-sm font-bold text-primary">Interlocuteur unique de A à Z</h4>
                <p class="text-xs text-on-surface-variant">Un seul artisan responsable du début à la fin de votre projet : plomberie, robinetterie, raccords et étanchéité.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 p-8 rounded-2xl bg-surface-container-high border border-primary/10 space-y-4 text-center">
          <div class="w-14 h-14 rounded-full bg-primary-container text-white flex items-center justify-center mx-auto mb-2">
            <span class="material-symbols-outlined text-[30px]">bathroom</span>
          </div>
          <h3 class="font-headline-sm text-xl text-primary font-bold">Un projet de salle de bain ou un WC à installer ?</h3>
          <p class="text-xs md:text-sm text-on-surface-variant max-w-md mx-auto">
            Discutez directement de vos besoins avec notre chef d'équipe plomberie pour obtenir des conseils personnalisés et un chiffrage rapide.
          </p>
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="tel:+3265794020"
              class="w-full sm:w-auto px-6 py-3.5 rounded-lg bg-primary-container text-white font-bold text-sm shadow hover:bg-forest-dark transition-all flex items-center justify-center gap-2"
            >
              <span class="material-symbols-outlined text-[20px] text-tertiary-fixed">call</span>
              <span>Ligne Directe : 065 / 79 40 20</span>
            </a>
            <a
              href="https://wa.me/32470552020?text=Bonjour,%20je%20souhaite%20un%20devis%20sanitaire%20à%20Mons"
              target="_blank"
              rel="noopener"
              class="w-full sm:w-auto px-6 py-3.5 rounded-lg bg-surface-container-lowest text-primary border border-primary/20 font-bold text-sm hover:bg-white transition-all flex items-center justify-center gap-2"
            >
              <span class="material-symbols-outlined text-[20px] text-primary-container">chat</span>
              <span>Devis WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area & Emergency Availability Details -->
  <section class="w-full py-16 bg-surface-container-low border-t border-primary/10">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-10">
        <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Secteur d'Intervention</span>
        <h2 class="font-headline-xl text-2xl md:text-3xl text-primary font-extrabold">
          Installations et dépannages sanitaires dans tout le Grand Mons
        </h2>
        <p class="text-sm text-on-surface-variant">
          Nos plombiers sanitaires se déplacent quotidiennement dans toutes les communes de Mons et du Borinage pour vos travaux et urgences sanitaires.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-center text-xs md:text-sm">
        <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-primary/10 font-bold text-primary">
          7000 Mons
        </div>
        <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-primary/10 font-bold text-primary">
          7011 Ghlin
        </div>
        <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-primary/10 font-bold text-primary">
          7012 Jemappes
        </div>
        <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-primary/10 font-bold text-primary">
          7020 Nimy / Maisières
        </div>
        <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-primary/10 font-bold text-primary">
          7033 Cuesmes
        </div>
        <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-primary/10 font-bold text-primary">
          7080 Frameries
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs Section -->
  <section class="w-full py-16 bg-background">
    <div class="max-w-4xl mx-auto px-4 md:px-8 space-y-8">
      <div class="text-center">
        <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Questions / Réponses</span>
        <h2 class="font-headline-xl text-2xl md:text-3xl text-primary font-extrabold mt-1">
          Questions fréquentes sur vos travaux sanitaires à Mons
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="p-5 rounded-xl bg-surface-container-lowest border border-primary/10 shadow-sm space-y-2">
            <h3 class="font-headline-sm text-base text-primary font-bold flex items-center gap-2">
              <span class="material-symbols-outlined text-primary-container text-[20px]">help_outline</span>
              <span>{faq.q}</span>
            </h3>
            <p class="text-xs md:text-sm text-on-surface-variant leading-relaxed pl-7">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final High-Conversion CTA -->
  <section class="w-full bg-primary text-white py-16">
    <div class="max-w-5xl mx-auto px-4 md:px-8 text-center space-y-6">
      <h2 class="font-display-hero text-3xl md:text-4xl text-white font-extrabold tracking-tight">
        Prêt à moderniser vos installations sanitaires ?
      </h2>
      <p class="text-sm md:text-base text-surface-dim max-w-2xl mx-auto leading-relaxed">
        Prenez contact avec nos plombiers certifiés à Mons pour un devis personnalisé, rapide et gratuit. Garantie sur toutes nos prestations.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a
          href="tel:+3265794020"
          class="px-8 py-4 rounded-xl bg-tertiary-container text-white font-bold text-lg shadow-lg hover:bg-tertiary transition-all flex items-center gap-2"
        >
          <span class="material-symbols-outlined text-[24px]">call</span>
          <span>Appeler le 065 / 79 40 20</span>
        </a>
        <a
