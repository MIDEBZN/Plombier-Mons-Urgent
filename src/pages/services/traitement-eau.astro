---
import Layout from '../../layouts/Layout.astro';
import TrustBar from '../../components/TrustBar.astro';
import QuoteForm from '../../components/QuoteForm.astro';

const includedItems = [
  { title: "Installation d'adoucisseurs d'eau volumétriques", desc: "Pose de systèmes intelligents dernière génération (BWT, Durlem, Minimax, EcoWater) calculant la régénération selon votre consommation réelle." },
  { title: "Adoucisseurs écologiques sans électricité", desc: "Modèles ultra-compacts fonctionnant uniquement grâce à la pression hydraulique, zéro consommation d'électricité et fonctionnement silencieux." },
  { title: "Test gratuit de dureté de l'eau (TH) à domicile", desc: "Mesure exacte du Titre Hydrotimétrique en degrés français (°fH) de votre eau SWDE avant et après notre intervention." },
  { title: "Pose de préfiltres anti-sédiments et filtres à impuretés", desc: "Protection de l'adoucisseur et des réseaux sanitaires contre les particules de sable, boues et micro-débris du réseau public." },
  { title: "Systèmes de filtration d'eau de boisson & osmoseurs", desc: "Purification sous évier éliminant le chlore, les résidus de pesticides, nitrates et micro-plastiques pour une eau pure au robinet." },
  { title: "Entretien annuel obligatoire et désinfection", desc: "Nettoyage du bac à sel, désinfection de la résine échangeuse d'ions, contrôle des cycles et vérification du TH résiduel." },
  { title: "Fourniture & livraison de sel régénérant purifié", desc: "Pastilles de sel haute densité certifiées EN 973 Type A évitant la formation de voûtes de sel dans le bac de stockage." },
  { title: "Raccordement by-pass et vanne mélangeuse réglable", desc: "Possibilité d'isoler l'adoucisseur à tout moment et réglage d'une eau douce équilibrée (TH idéal entre 7°fH et 10°fH)." }
];

const commonProblems = [
  { title: "Traces blanches tenaces de calcaire", icon: "water_drop", desc: "Dépôts blanchâtres incrustés sur les parois vitrées de douche, l'inox des éviers, le carrelage et la robinetterie." },
  { title: "Surconsommation électrique du chauffe-eau", icon: "bolt", desc: "1 mm de calcaire sur une résistance augmente de 10 % la facture d'énergie liée à la production d'eau chaude." },
  { title: "Peau sèche, tiraillements et cheveux rêches", icon: "face", desc: "L'eau très dure de Mons agresse l'épiderme, favorise l'eczéma et rend les cheveux cassants après chaque lavage." },
  { title: "Pannes prématurées des électroménagers", icon: "local_laundry_service", desc: "Résistances de lave-linge, lave-vaisselle et machines à café rongées prématurément par l'accumulation de tartre." },
  { title: "Perte de pression dans les tuyauteries", icon: "speed", desc: "Rétrécissement progressif du diamètre intérieur des tuyaux en cuivre sous l'effet du dépôt constant de calcaire." },
  { title: "Goût de chlore et odeur désagréable au robinet", icon: "sentiment_dissatisfied", desc: "L'eau du réseau municipal peut présenter un arrière-goût chimique désagréable qui altère vos boissons chaudes." }
];

const faqs = [
  {
    q: "Quelle est la dureté de l'eau du robinet à Mons ?",
    a: "L'eau distribuée par la SWDE à Mons et dans le Borinage provient principalement des nappes souterraines crayeuses. Sa dureté oscille généralement entre 32°fH et 38°fH (degrés français), ce qui la classe officiellement parmi les eaux 'très dures' de Wallonie. Sans traitement, le tartre endommage rapidement toutes vos installations."
  },
  {
    q: "Combien coûte l'installation d'un adoucisseur d'eau à Mons ?",
    a: "Le tarif d'une installation complète d'adoucisseur d'eau varie entre 1 250 € et 2 350 € TTC selon la taille du ménage, la marque choisie (Durlem, BWT, etc.) et le type d'adoucisseur (volumétrique électrique ou compact sans électricité). Ce prix comprend le matériel, le préfiltre, le by-pass et la mise en service."
  },
  {
    q: "L'eau adoucie reste-t-elle potable pour la consommation ?",
    a: "Oui, tout à fait. L'adoucisseur remplace les ions calcium et magnésium par une infime quantité d'ions sodium, restant très largement sous les seuils réglementaires fixés par l'OMS et la directive européenne (200 mg de sodium par litre). De plus, nous réglons toujours une vanne de mélange pour conserver un TH résiduel agréable d'environ 7 à 9°fH."
  },
  {
    q: "Quelle est la fréquence d'entretien d'un adoucisseur d'eau ?",
    a: "Un entretien annuel est fortement recommandé. Il consiste à désinfecter les résines, nettoyer la crépine et le bac à sel, vérifier l'étanchéité des vannes et contrôler la dureté de sortie. Il faut également recharger le bac en pastilles de sel environ 3 à 4 fois par an selon votre consommation."
  },
  {
    q: "Quelles économies réalise-t-on avec un adoucisseur d'eau ?",
    a: "Un ménage de 4 personnes économise en moyenne entre 400 € et 650 € par an : réduction de 15 à 20 % de la facture d'énergie pour l'eau chaude, réduction de 50 % des doses de savon, lessive et shampoing, suppression des produits détartrants chimiques et prolongation de la durée de vie de vos électroménagers."
  }
];
---

<Layout
  title="Adoucisseur d'Eau Mons | Anti-Calcaire, Installation & Entretien"
  description="Installation et entretien d'adoucisseurs d'eau à Mons. Éliminez le calcaire très dur de la SWDE (35°F). Modèles BWT & Durlem économiques. Devis gratuit."
  serviceData={{
    name: "Installation et Entretien d'Adoucisseurs d'Eau Anti-Calcaire",
    description: "Protection contre l'eau très dure de Mons (35°F), pose d'adoucisseurs écologiques BWT / Durlem et recharge sel.",
    serviceType: "Water Treatment & Softener"
  }}
>
  <!-- Hero Section -->
  <section class="relative w-full bg-background overflow-hidden py-10 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-7 space-y-4 md:space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-container-high text-primary font-bold text-xs md:text-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-primary-container pulse-emergency"></span>
            <span>Spécialiste Traitement de l'Eau SWDE Mons • TVA 6%</span>
          </div>

          <h1 class="font-display-hero text-3xl sm:text-4xl lg:text-5xl text-primary font-extrabold tracking-tight leading-tight">
            Adoucisseurs d'Eau & Filtration du Calcaire à Mons
          </h1>

          <p class="font-body-lg text-base md:text-lg text-on-surface-variant max-w-2xl leading-relaxed">
            À Mons, l'eau de ville est exceptionnellement calcaire (jusqu'à 38°fH). Protégez vos tuyauteries, votre chaudière et votre peau grâce à <strong>l'installation d'un adoucisseur d'eau dernière génération</strong>, économique et garanti.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
            <div class="flex items-center gap-2.5 text-sm font-semibold text-on-surface">
              <span class="material-symbols-outlined text-primary-container text-[22px]">water</span>
              <span>Suppression totale du calcaire incrustant</span>
            </div>
            <div class="flex items-center gap-2.5 text-sm font-semibold text-on-surface">
              <span class="material-symbols-outlined text-primary-container text-[22px]">savings</span>
              <span>Jusqu'à 650 € d'économies annuelles d'énergie et de produits</span>
            </div>
            <div class="flex items-center gap-2.5 text-sm font-semibold text-on-surface">
              <span class="material-symbols-outlined text-primary-container text-[22px]">verified</span>
              <span>Grandes marques : Durlem (belge), BWT, EcoWater</span>
            </div>
            <div class="flex items-center gap-2.5 text-sm font-semibold text-on-surface">
              <span class="material-symbols-outlined text-primary-container text-[22px]">percent</span>
              <span>TVA réduite à 6 % pour les habitations de plus de 10 ans</span>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-4 pt-3">
            <a
              href="tel:+3265794020"
              class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-lg bg-primary-container text-white font-bold text-base hover:bg-forest-dark shadow-md transition-all hover:-translate-y-0.5"
            >
              <span class="material-symbols-outlined text-[22px] text-tertiary-fixed">call</span>
              <span>Appeler le 065 / 79 40 20</span>
            </a>
            <a
              href="https://wa.me/32470552020?text=Bonjour,%20je%20souhaite%20un%20test%20calcaire%20ou%20un%20devis%20adoucisseur%20à%20Mons"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-lg bg-surface-container-high text-primary font-bold text-base hover:bg-surface-container-highest transition-all border border-primary/10"
            >
              <span class="material-symbols-outlined text-[22px] text-primary-container">chat</span>
              <span>Test Calcaire & Devis WhatsApp</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 w-full">
          <QuoteForm title="Adoucisseur d'Eau" subtitle="Test de dureté gratuit et devis sans engagement à Mons" />
        </div>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- What's Included -->
  <section class="w-full py-16 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Solutions Anti-Tartre</span>
        <h2 class="font-headline-xl text-2xl md:text-3xl text-primary font-extrabold mt-1">
          Nos solutions de traitement et filtration d'eau à Mons
        </h2>
        <p class="text-sm md:text-base text-on-surface-variant mt-2">
          De l'adoucisseur familial compact au système de filtration sous évier pour une eau pure et sans goût.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {includedItems.map((item, idx) => (
          <div class="p-5 rounded-xl bg-surface-container-lowest border border-primary/10 shadow-sm flex flex-col justify-between">
            <div>
              <div class="w-9 h-9 rounded-lg bg-primary-container text-white flex items-center justify-center font-bold text-xs mb-3">
                0{idx + 1}
              </div>
              <h3 class="font-headline-sm text-base text-primary font-bold">{item.title}</h3>
              <p class="text-xs text-on-surface-variant mt-2 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Common Problems We Solve -->
  <section class="w-full py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Conséquences du Calcaire</span>
        <h2 class="font-headline-xl text-2xl md:text-3xl text-primary font-extrabold mt-1">
          Les problèmes causés par l'eau dure que nous supprimons
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {commonProblems.map((prob) => (
          <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm card-hover-effect">
            <div class="w-12 h-12 rounded-xl bg-surface-container-high text-primary-container flex items-center justify-center mb-4">
              <span class="material-symbols-outlined text-[28px]">{prob.icon}</span>
            </div>
            <h3 class="font-headline-sm text-base text-primary font-bold">{prob.title}</h3>
            <p class="text-xs md:text-sm text-on-surface-variant mt-2 leading-relaxed">{prob.desc}</p>
            <div class="pt-4 mt-4 border-t border-primary/5 flex items-center justify-between">
              <a href="tel:+3265794020" class="text-xs font-bold text-primary-container hover:underline flex items-center gap-1">
                <span>Éliminer le calcaire</span>
                <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Step-by-Step Process -->
  <section class="w-full py-16 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Installation Maîtrisée</span>
        <h2 class="font-headline-xl text-2xl md:text-3xl text-primary font-extrabold mt-1">
          Notre processus d'installation d'un adoucisseur d'eau
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm relative overflow-hidden">
          <span class="text-6xl font-extrabold text-primary/5 absolute top-2 right-4">01</span>
          <div class="w-10 h-10 rounded-lg bg-primary-container text-white flex items-center justify-center font-bold text-base mb-4">1</div>
          <h3 class="font-headline-sm text-base text-primary font-bold">Mesure du TH à Domicile</h3>
          <p class="text-xs text-on-surface-variant mt-2 leading-relaxed">
            Test par réactif titrimétrique de l'eau de votre robinet pour déterminer exactement son taux de dureté calcaire.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm relative overflow-hidden">
          <span class="text-6xl font-extrabold text-primary/5 absolute top-2 right-4">02</span>
          <div class="w-10 h-10 rounded-lg bg-primary-container text-white flex items-center justify-center font-bold text-base mb-4">2</div>
          <h3 class="font-headline-sm text-base text-primary font-bold">Choix & Devis Fixe</h3>
          <p class="text-xs text-on-surface-variant mt-2 leading-relaxed">
            Sélection de la capacité en résine (10L, 15L, 22L) adaptée à votre nombre d'occupants et devis clair sans surprise.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm relative overflow-hidden">
          <span class="text-6xl font-extrabold text-primary/5 absolute top-2 right-4">03</span>
          <div class="w-10 h-10 rounded-lg bg-primary-container text-white flex items-center justify-center font-bold text-base mb-4">3</div>
          <h3 class="font-headline-sm text-base text-primary font-bold">Pose du By-Pass & Filtre</h3>
          <p class="text-xs text-on-surface-variant mt-2 leading-relaxed">
            Raccordement sur l'arrivée d'eau principale après compteur, pose d'un préfiltre 20 microns et raccordement à l'égout.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm relative overflow-hidden">
          <span class="text-6xl font-extrabold text-primary/5 absolute top-2 right-4">04</span>
          <div class="w-10 h-10 rounded-lg bg-primary-container text-white flex items-center justify-center font-bold text-base mb-4">4</div>
          <h3 class="font-headline-sm text-base text-primary font-bold">Mise en Eau & Test Final</h3>
          <p class="text-xs text-on-surface-variant mt-2 leading-relaxed">
            Cycle de régénération de test, vérification d'étanchéité, réglage de la dureté de sortie à 8°fH et fourniture du sel.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="w-full py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 space-y-4">
          <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Avantages Certifiés</span>
          <h2 class="font-headline-xl text-2xl md:text-3xl text-primary font-extrabold">
            Pourquoi choisir notre service de traitement de l'eau à Mons ?
          </h2>
          <p class="text-sm text-on-surface-variant leading-relaxed">
            L'eau du bassin montois est réputée pour sa très haute teneur en calcaire. En confiant votre équipement à des spécialistes locaux, vous avez l'assurance d'un réglage parfait et d'un suivi sur le long terme.
          </p>

          <div class="space-y-3 pt-2">
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary-container text-[22px] mt-0.5">verified_user</span>
              <div>
                <h4 class="text-sm font-bold text-primary">Marques fiables et résines de haute qualité</h4>
                <p class="text-xs text-on-surface-variant">Adoucisseurs Durlem (fabrication belge), BWT et EcoWater avec garanties étendues jusqu'à 10 ans.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary-container text-[22px] mt-0.5">water_drop</span>
              <div>
                <h4 class="text-sm font-bold text-primary">Faible consommation de sel et d'eau</h4>
                <p class="text-xs text-on-surface-variant">Vannes volumétriques intelligentes qui ne régénèrent que lorsque c'est strictement nécessaire.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary-container text-[22px] mt-0.5">percent</span>
              <div>
                <h4 class="text-sm font-bold text-primary">TVA 6 % pour logements de plus de 10 ans</h4>
                <p class="text-xs text-on-surface-variant">Facturation avec taux réduit officiel de 6 % applicable sur la fourniture et la pose de l'adoucisseur.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 p-8 rounded-2xl bg-surface-container-high border border-primary/10 space-y-4 text-center">
          <div class="w-14 h-14 rounded-full bg-primary-container text-white flex items-center justify-center mx-auto mb-2">
            <span class="material-symbols-outlined text-[30px]">water</span>
          </div>
          <h3 class="font-headline-sm text-xl text-primary font-bold">Marre du calcaire incrusté dans votre maison ?</h3>
          <p class="text-xs md:text-sm text-on-surface-variant max-w-md mx-auto">
            Demandez un test gratuit de la dureté de votre eau et un devis sans engagement pour un adoucisseur sur-mesure.
          </p>
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="tel:+3265794020"
              class="w-full sm:w-auto px-6 py-3.5 rounded-lg bg-primary-container text-white font-bold text-sm shadow hover:bg-forest-dark transition-all flex items-center justify-center gap-2"
            >
              <span class="material-symbols-outlined text-[20px] text-tertiary-fixed">call</span>
              <span>Ligne Directe : 065 / 79 40 20</span>
            </a>
            <a
              href="https://wa.me/32470552020?text=Bonjour,%20j'aimerais%20un%20devis%20pour%20un%20adoucisseur%20à%20Mons"
              target="_blank"
              rel="noopener"
              class="w-full sm:w-auto px-6 py-3.5 rounded-lg bg-surface-container-lowest text-primary border border-primary/20 font-bold text-sm hover:bg-white transition-all flex items-center justify-center gap-2"
            >
              <span class="material-symbols-outlined text-[20px] text-primary-container">chat</span>
              <span>Devis WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area & Emergency Availability Details -->
  <section class="w-full py-16 bg-surface-container-low border-t border-primary/10">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-10">
        <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Zone d'Intervention</span>
        <h2 class="font-headline-xl text-2xl md:text-3xl text-primary font-extrabold">
          Pose et entretien d'adoucisseurs d'eau dans toute la région de Mons
        </h2>
        <p class="text-sm text-on-surface-variant">
          Nos techniciens traitent les eaux très calcaires de tout le réseau SWDE sur Mons et l'ensemble du Borinage.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-center text-xs md:text-sm">
        <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-primary/10 font-bold text-primary">
          7000 Mons
        </div>
        <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-primary/10 font-bold text-primary">
          7011 Ghlin
        </div>
        <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-primary/10 font-bold text-primary">
          7012 Jemappes
        </div>
        <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-primary/10 font-bold text-primary">
          7020 Nimy
        </div>
        <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-primary/10 font-bold text-primary">
          7033 Cuesmes
        </div>
        <div class="p-3.5 rounded-xl bg-surface-container-lowest border border-primary/10 font-bold text-primary">
          7080 Frameries
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs Section -->
  <section class="w-full py-16 bg-background">
    <div class="max-w-4xl mx-auto px-4 md:px-8 space-y-8">
      <div class="text-center">
        <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Questions / Réponses</span>
        <h2 class="font-headline-xl text-2xl md:text-3xl text-primary font-extrabold mt-1">
          Questions fréquentes sur les adoucisseurs d'eau à Mons
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="p-5 rounded-xl bg-surface-container-lowest border border-primary/10 shadow-sm space-y-2">
            <h3 class="font-headline-sm text-base text-primary font-bold flex items-center gap-2">
              <span class="material-symbols-outlined text-primary-container text-[20px]">help_outline</span>
              <span>{faq.q}</span>
            </h3>
            <p class="text-xs md:text-sm text-on-surface-variant leading-relaxed pl-7">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final High-Conversion CTA -->
  <section class="w-full bg-primary text-white py-16">
    <div class="max-w-5xl mx-auto px-4 md:px-8 text-center space-y-6">
      <h2 class="font-display-hero text-3xl md:text-4xl text-white font-extrabold tracking-tight">
        Dites adieu au calcaire à Mons dès aujourd'hui
      </h2>
      <p class="text-sm md:text-base text-surface-dim max-w-2xl mx-auto leading-relaxed">
        Bénéficiez de la TVA à 6 % sur votre installation d'adoucisseur. Contactez-nous pour une analyse d'eau offerte à domicile.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
