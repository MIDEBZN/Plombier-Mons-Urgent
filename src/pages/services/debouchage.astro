---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout
  title="Débouchage WC, Égout & Canalisation à Mons | Haute Pression 350 Bars | 24/7"
  description="Débouchage urgent de WC, éviers, égouts et canalisations à Mons et Borinage. Curage hydrodynamique haute pression, inspection caméra et vidange de fosse. 0489 16 43 78."
  canonicalPath="/services/debouchage"
  currentPage="services"
>
  <!-- Hero Section -->
  <section class="section" style="background: radial-gradient(circle at 85% 15%, rgba(0, 128, 128, 0.08) 0%, transparent 60%), #FFFFFF; padding-top: 3rem; padding-bottom: 3.5rem;">
    <div class="container">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem; font-size: 0.875rem; color: var(--color-navy-muted);">
        <a href="/" style="color: var(--color-teal); text-decoration: none;">Accueil</a>
        <span style="margin: 0 0.5rem; color: var(--color-border);">/</span>
        <a href="/services" style="color: var(--color-teal); text-decoration: none;">Services</a>
        <span style="margin: 0 0.5rem; color: var(--color-border);">/</span>
        <span style="color: var(--color-navy); font-weight: 600;">Débouchage de Canalisations</span>
      </nav>

      <div style="display: grid; grid-template-columns: 1fr; gap: 2rem;">
        <div style="max-width: 850px;">
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
            <span class="badge badge-primary">
              <span class="material-symbols-outlined" style="font-size: 15px;">cleaning_services</span>
              Hydrocurage Haute Pression 350 Bars
            </span>
            <span class="badge badge-alert">
              <span class="material-symbols-outlined" style="font-size: 15px;">warning</span>
              Débouchage Urgent 24h/24 & 7j/7
            </span>
          </div>

          <h1 style="font-size: clamp(2.2rem, 4vw, 3.4rem); line-height: 1.15; margin-bottom: 1.25rem;">
            Débouchage WC, Éviers, Égouts et Canalisations à Mons
          </h1>

          <p style="font-size: 1.15rem; color: var(--color-navy-muted); line-height: 1.6; margin-bottom: 2rem;">
            WC qui déborde, sterput de cave inondé d'eaux usées ou refoulement général du réseau d'égouttage ? Nous intervenons avec notre camion hydrocureur haute pression et nos caméras d'inspection robotisées pour désobstruer vos conduits en moins de 30 minutes sans démolition.
          </p>

          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="tel:0489164378" class="btn btn-alert" style="font-size: 1.1rem; padding: 0.9rem 1.8rem;">
              <span class="material-symbols-outlined">call</span>
              Débouchage Express : 0489 16 43 78
            </a>
            <a href="#devis-section" class="btn btn-outline" style="font-size: 1.05rem;">
              <span class="material-symbols-outlined">description</span>
              Demander un devis débouchage
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Metrics Bar -->
  <section style="background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 1.5rem 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; text-align: center;">
        <div>
          <div style="font-size: 1.8rem; font-weight: 800; color: var(--color-teal); font-family: var(--font-headline);">350 Bars</div>
          <div style="font-size: 0.85rem; color: var(--color-navy-muted); font-weight: 600;">Puissance hydrocurage professionnelle</div>
        </div>
        <div>
          <div style="font-size: 1.8rem; font-weight: 800; color: var(--color-alert); font-family: var(--font-headline);">20 a 30 min</div>
          <div style="font-size: 0.85rem; color: var(--color-navy-muted); font-weight: 600;">Délai d'intervention à Mons</div>
        </div>
        <div>
          <div style="font-size: 1.8rem; font-weight: 800; color: var(--color-navy); font-family: var(--font-headline);">Inspection Vidéo HD</div>
          <div style="font-size: 0.85rem; color: var(--color-navy-muted); font-weight: 600;">Caméra couleur avec rapport clé USB</div>
        </div>
        <div>
          <div style="font-size: 1.8rem; font-weight: 800; color: var(--color-navy); font-family: var(--font-headline);">Garantie Résultat</div>
          <div style="font-size: 0.85rem; color: var(--color-navy-muted); font-weight: 600;">Écoulement optimal certifié</div>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="section">
    <div class="container">
      <div style="max-width: 720px; margin-bottom: 2.5rem;">
        <span class="badge badge-primary" style="margin-bottom: 0.75rem;">Services Complets de Désobstruction</span>
        <h2 style="font-size: 2.2rem; margin-bottom: 1rem;">Ce qui est inclus dans notre prestation de débouchage</h2>
        <p style="color: var(--color-navy-muted); font-size: 1rem; line-height: 1.6;">
          Du petit siphon de lavabo jusqu'au collecteur communal d'égouts, nous disposons du matériel adapté à chaque diamètre et configuration de tuyauterie.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
        <div class="card">
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
            <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(0, 128, 128, 0.1); color: var(--color-teal); display: flex; align-items: center; justify-content: center;">
              <span class="material-symbols-outlined">wc</span>
            </div>
            <h3 style="font-size: 1.15rem; margin: 0;">Débouchage WC & Sanitaires</h3>
          </div>
          <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.9rem; color: var(--color-navy-muted); display: flex; flex-direction: column; gap: 0.5rem;">
            <li>Débouchage mécanique au furet électrique RIDGID K-45 sans rayer la céramique de cuvette.</li>
            <li>Extraction des amas de lingettes, tampons, blocs WC tombés par mégarde et tartre compact.</li>
            <li>Rétablissement d'une évacuation fluide et désinfection complète des surfaces d'intervention.</li>
          </ul>
        </div>

        <div class="card">
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
            <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(0, 128, 128, 0.1); color: var(--color-teal); display: flex; align-items: center; justify-content: center;">
              <span class="material-symbols-outlined">water</span>
            </div>
            <h3 style="font-size: 1.15rem; margin: 0;">Curage Haute Pression & Égouttage</h3>
          </div>
          <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.9rem; color: var(--color-navy-muted); display: flex; flex-direction: column; gap: 0.5rem;">
            <li>Hydrocurage 350 bars avec têtes rotatives perforatrices adaptées du diamètre 40 mm au 250 mm.</li>
            <li>Nettoyage intégral des parois de conduite : décollement des sédiments gras, boues et calcaire incrusté.</li>
            <li>Débouchage de chambre de visite extérieure, sterput de garage et rigoles pluviales.</li>
          </ul>
        </div>

        <div class="card">
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
            <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(0, 128, 128, 0.1); color: var(--color-teal); display: flex; align-items: center; justify-content: center;">
              <span class="material-symbols-outlined">videocam</span>
            </div>
            <h3 style="font-size: 1.15rem; margin: 0;">Inspection Caméra & Vidange Fosse</h3>
          </div>
          <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.9rem; color: var(--color-navy-muted); display: flex; flex-direction: column; gap: 0.5rem;">
            <li>Passage de sonde endoscopique haute définition avec enregistrement vidéo et localisation par sonde émettrice 512 Hz.</li>
            <li>Identification exacte des cassures, contre-pentes, écrasements ou racines infiltrées.</li>
            <li>Vidange et pompage de fosses septiques, bacs à graisses et puits perdus avec certificat de traitement agréé.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Common Problems We Solve -->
  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div style="max-width: 720px; margin-bottom: 2.5rem;">
        <span class="badge badge-alert" style="margin-bottom: 0.75rem;">Problèmes Fréquents à Mons</span>
        <h2 style="font-size: 2.2rem; margin-bottom: 1rem;">Les blocages d'évacuation que nous solutionnons</h2>
        <p style="color: var(--color-navy-muted); font-size: 1rem; line-height: 1.6;">
          Dans le bassin montois et le Borinage, les réseaux d'évacuation anciens subissent des contraintes lourdes dues au sous-sol calcaire et à l'affaissement des terrains miniers :
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
        <div class="card" style="border-left: 3px solid var(--color-teal);">
          <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--color-navy);">WC totalement bouché qui menace de déborder</h3>
          <p style="font-size: 0.9rem; color: var(--color-navy-muted); margin-bottom: 0.5rem;">
            Tirer la chasse fait monter l'eau jusqu'au bord de la cuvette sans évacuation. Souvent provoqué par des lingettes humides ou un bouchon compact de papier toilette.
          </p>
          <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-teal);">Solution : Furet mécanique professionnel ou hydrocurage sans endommager l'émail.</span>
        </div>

        <div class="card" style="border-left: 3px solid var(--color-teal);">
          <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--color-navy);">Sterput de cave ou garage qui refoule lors des pluies</h3>
          <p style="font-size: 0.9rem; color: var(--color-navy-muted); margin-bottom: 0.5rem;">
            Le siphon de sol (sterput typique belge) déborde et fait remonter des eaux croupies et nauséabondes sur la dalle de béton.
          </p>
          <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-teal);">Solution : Désobstruction sous pression et pose éventuelle de clapet anti-retour.</span>
        </div>

        <div class="card" style="border-left: 3px solid var(--color-teal);">
          <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--color-navy);">Évier de cuisine avec stagnation et remontées de graisse</h3>
          <p style="font-size: 0.9rem; color: var(--color-navy-muted); margin-bottom: 0.5rem;">
            L'eau met des dizaines de minutes à s'écouler. L'accumulation d'huiles de cuisson et de restes alimentaires a créé un agglomérat saponifié dur comme de la pierre.
          </p>
          <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-teal);">Solution : Décapage hydrodynamique pour rendre aux conduites leur section initiale.</span>
        </div>

        <div class="card" style="border-left: 3px solid var(--color-teal);">
          <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--color-navy);">Chambre de visite extérieure pleine et débordante</h3>
          <p style="font-size: 0.9rem; color: var(--color-navy-muted); margin-bottom: 0.5rem;">
            La boîte de raccordement dans le jardin ou l'allée est saturée d'excréments et de papier car le collecteur communal ou la fosse refuse d'avaler les effluents.
          </p>
          <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-teal);">Solution : Hydrocureur 350 bars pour traverser le bouchon principal en quelques minutes.</span>
        </div>

        <div class="card" style="border-left: 3px solid var(--color-teal);">
          <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--color-navy);">Odeurs d'égout persistantes dans toute la maison</h3>
          <p style="font-size: 0.9rem; color: var(--color-navy-muted); margin-bottom: 0.5rem;">
            Une odeur insupportable de soufre et d'égout se dégage des siphons, révélant un désamorçage de colonne, un évent obstrué ou une fissure cachée.
          </p>
          <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-teal);">Solution : Test au fumigène et inspection caméra pour localiser la rupture d'étanchéité.</span>
        </div>

        <div class="card" style="border-left: 3px solid var(--color-teal);">
          <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--color-navy);">Racines d'arbres ayant percé les canalisations en grès</h3>
          <p style="font-size: 0.9rem; color: var(--color-navy-muted); margin-bottom: 0.5rem;">
            Très fréquent dans les maisons d'époque montoises : les racines de conifères et haies pénètrent les joints de grès et forment un filet infranchissable.
          </p>
          <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-teal);">Solution : Tête fraiseuse rotative coupe-racines haute vitesse sans déterrer le terrain.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Step-by-Step Process -->
  <section class="section">
    <div class="container">
      <div style="max-width: 720px; margin-bottom: 3rem;">
        <span class="badge badge-primary" style="margin-bottom: 0.75rem;">Méthode Professionnelle</span>
        <h2 style="font-size: 2.2rem; margin-bottom: 1rem;">Notre protocole de débouchage en 5 étapes</h2>
        <p style="color: var(--color-navy-muted); font-size: 1rem; line-height: 1.6;">
          Nous appliquons une méthode rigoureuse pour garantir un débouchage propre, rapide et sans récidive :
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
        <div class="card">
          <div style="font-size: 2rem; font-weight: 800; color: var(--color-teal); font-family: var(--font-headline); margin-bottom: 0.5rem;">01</div>
          <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem;">Diagnostic de l'Engorgement</h3>
          <p style="font-size: 0.85rem; color: var(--color-navy-muted); margin: 0; line-height: 1.5;">
            Localisation de l'origine du blocage (localisé au siphon ou généralisé au collecteur d'égout communal).
          </p>
        </div>

        <div class="card">
          <div style="font-size: 2rem; font-weight: 800; color: var(--color-teal); font-family: var(--font-headline); margin-bottom: 0.5rem;">02</div>
          <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem;">Choix de l'Outil Adapté</h3>
          <p style="font-size: 0.85rem; color: var(--color-navy-muted); margin: 0; line-height: 1.5;">
            Sélection de la buse d'hydrocurage ou du furet mécanique calibré pour ne pas fissurer la canalisation (PVC, fonte ou grès).
          </p>
        </div>

        <div class="card">
          <div style="font-size: 2rem; font-weight: 800; color: var(--color-teal); font-family: var(--font-headline); margin-bottom: 0.5rem;">03</div>
          <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem;">Curage Hydrodynamique</h3>
          <p style="font-size: 0.85rem; color: var(--color-navy-muted); margin: 0; line-height: 1.5;">
            Projection d'eau jusqu'à 350 bars pour désintégrer le bouchon et récurer les sédiments jusqu'à la paroi lisse du tube.
          </p>
        </div>

        <div class="card">
          <div style="font-size: 2rem; font-weight: 800; color: var(--color-teal); font-family: var(--font-headline); margin-bottom: 0.5rem;">04</div>
          <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem;">Contrôle Caméra Vidéo</h3>
          <p style="font-size: 0.85rem; color: var(--color-navy-muted); margin: 0; line-height: 1.5;">
            Passage de la caméra d'inspection pour vérifier visuellement le dégagement total et s'assurer de l'absence de fissure.
          </p>
        </div>

        <div class="card">
          <div style="font-size: 2rem; font-weight: 800; color: var(--color-teal); font-family: var(--font-headline); margin-bottom: 0.5rem;">05</div>
          <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem;">Test Débit & Propreté</h3>
          <p style="font-size: 0.85rem; color: var(--color-navy-muted); margin: 0; line-height: 1.5;">
            Test à plein débit d'écoulement, désinfection et remise d'un compte-rendu avec conseils préventifs d'entretien.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section" style="background: var(--color-navy); color: white;">
    <div class="container">
      <div style="text-align: center; max-width: 700px; margin: 0 auto 3rem;">
        <span class="badge" style="background: rgba(0, 128, 128, 0.3); color: #4DD0E1; margin-bottom: 0.75rem;">Notre Supériorité Technique</span>
        <h2 style="font-size: 2.2rem; color: white; margin-bottom: 1rem;">Pourquoi faire appel à Plombier Mons Urgent pour vos égouts</h2>
        <p style="color: #CBD5E1; font-size: 1rem;">
          Les ventouses et produits chimiques de supermarché détruisent vos joints sans dissoudre les bouchons massifs. Nous intervenons avec du matériel industriel éprouvé.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
        <div style="background: rgba(255, 255, 255, 0.05); padding: 2rem; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.1);">
          <div style="width: 48px; height: 48px; border-radius: 10px; background: var(--color-teal); color: white; display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem;">
            <span class="material-symbols-outlined">precision_manufacturing</span>
          </div>
          <h3 style="font-size: 1.2rem; color: white; margin-bottom: 0.5rem;">Camionnette Hydrocureuse Autonome</h3>
          <p style="color: #94A3B8; font-size: 0.9rem; margin: 0; line-height: 1.6;">
            Véhicule équipé de réserve d'eau et groupe moteur thermique indépendant, capable d'intervenir dans les ruelles pavées du centre historique de Mons comme dans les cours fermées.
          </p>
        </div>

        <div style="background: rgba(255, 255, 255, 0.05); padding: 2rem; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.1);">
          <div style="width: 48px; height: 48px; border-radius: 10px; background: var(--color-teal); color: white; display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem;">
            <span class="material-symbols-outlined">visibility</span>
          </div>
          <h3 style="font-size: 1.2rem; color: white; margin-bottom: 0.5rem;">Diagnostic Visuel Transparent</h3>
          <p style="color: #94A3B8; font-size: 0.9rem; margin: 0; line-height: 1.6;">
            Vous voyez sur écran haute résolution exactement ce qui bloque votre canalisation. Nous ne facturons aucun travail imaginaire.
          </p>
        </div>

        <div style="background: rgba(255, 255, 255, 0.05); padding: 2rem; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.1);">
          <div style="width: 48px; height: 48px; border-radius: 10px; background: var(--color-teal); color: white; display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem;">
            <span class="material-symbols-outlined">nature_people</span>
          </div>
          <h3 style="font-size: 1.2rem; color: white; margin-bottom: 0.5rem;">Écologique : Zéro Produit Chimique Acide</h3>
          <p style="color: #94A3B8; font-size: 0.9rem; margin: 0; line-height: 1.6;">
            Nous utilisons la seule force cinétique de l'eau pure propulsée à haute pression, préservant l'intégrité de vos canalisations et respectant les normes environnementales wallonnes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Emergency Availability & Service Area -->
  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: start;">
        <div>
          <span class="badge badge-alert" style="margin-bottom: 0.75rem;">Astreinte Débouchage</span>
          <h2 style="font-size: 2rem; margin-bottom: 1rem;">Intervention 24/7 en cas de refoulement critique</h2>
          <p style="color: var(--color-navy-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;">
            Un WC qui déborde un dimanche soir ne peut pas attendre le lundi matin. Notre brigade d'hydrocurage est prête à intervenir à tout instant.
          </p>

          <div class="card" style="margin-bottom: 1.5rem; background: white;">
            <div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 0.75rem;">
              <span class="material-symbols-outlined" style="color: var(--color-alert); font-size: 28px;">bolt</span>
              <div>
                <strong style="color: var(--color-navy); display: block;">Déblocage d'extrême urgence</strong>
                <span style="font-size: 0.85rem; color: var(--color-navy-muted);">Véhicule de débouchage déployé immédiatement dans votre quartier.</span>
              </div>
            </div>
            <div style="display: flex; gap: 1rem; align-items: center;">
              <span class="material-symbols-outlined" style="color: var(--color-teal); font-size: 28px;">restore</span>
              <div>
                <strong style="color: var(--color-navy); display: block;">Disponibilité totale 365j/an</strong>
                <span style="font-size: 0.85rem; color: var(--color-navy-muted);">Même pendant les congés du bâtiment et les jours fériés.</span>
              </div>
            </div>
          </div>

          <a href="tel:0489164378" class="btn btn-alert" style="width: 100%; justify-content: center;">
            <span class="material-symbols-outlined">call</span>
            Urgence Débouchage : 0489 16 43 78
          </a>
        </div>

        <div>
          <span class="badge badge-primary" style="margin-bottom: 0.75rem;">Couverture Territoriale</span>
          <h2 style="font-size: 2rem; margin-bottom: 1rem;">Communes desservies en 20 à 30 min</h2>
          <p style="color: var(--color-navy-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.25rem;">
            Notre véhicule d'hydrocurage se déplace sans surcoût kilométrique abusif sur l'ensemble de la zone :
          </p>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.875rem;">
            <div style="background: white; padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid var(--color-border);">
              <strong style="color: var(--color-teal); display: block; margin-bottom: 0.25rem;">Mons Agglomération :</strong>
