---
import Layout from '../layouts/Layout.astro';
import TrustBar from '../components/TrustBar.astro';
import QuoteForm from '../components/QuoteForm.astro';
---

<Layout
  title="Contact & Urgence Plombier Mons 24h/24 | 065 79 40 20"
  description="Contactez Plombier Mons Urgent pour un dépannage immédiat en 30 minutes ou un devis gratuit. Permanence téléphonique 24/7 : 065 79 40 20."
>
  <!-- Page Header -->
  <section class="w-full bg-primary text-white py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 md:px-8 text-center space-y-4">
      <span class="text-xs uppercase tracking-widest font-extrabold text-tertiary-fixed">Assistance 24/7</span>
      <h1 class="font-display-hero text-3xl md:text-5xl text-white font-extrabold tracking-tight">
        Contactez votre Plombier à Mons
      </h1>
      <p class="text-sm md:text-base text-surface-dim max-w-2xl mx-auto leading-relaxed">
        Besoin d'un dépannage immédiat ou d'un devis pour vos travaux de plomberie et chauffage ? Notre permanence est joignable 24h/24 et 7j/7.
      </p>
    </div>
  </section>

  <TrustBar />

  <!-- Main Contact Grid -->
  <section class="w-full py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Contact Info & Checklist -->
        <div class="lg:col-span-6 space-y-8">
          <div class="p-6 md:p-8 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm space-y-6">
            <h2 class="font-headline-xl text-2xl text-primary font-extrabold">Coordonnées Directes</h2>

            <div class="space-y-4 text-sm md:text-base">
              <!-- Hotline -->
              <div class="flex items-start gap-4 p-4 rounded-xl bg-surface-container-high border border-primary/10">
                <div class="w-12 h-12 rounded-lg bg-primary-container text-white flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-[24px]">phone_in_talk</span>
                </div>
                <div>
                  <span class="text-xs uppercase tracking-wider font-bold text-secondary block">Permanence Mons (Fixe)</span>
                  <a href="tel:+3265794020" class="font-headline-sm text-xl text-primary font-extrabold hover:text-primary-container">
                    065 / 79 40 20
                  </a>
                  <p class="text-xs text-secondary mt-0.5">Ligne prioritaire pour urgences dans le Grand Mons</p>
                </div>
              </div>

              <!-- Mobile Urgence -->
              <div class="flex items-start gap-4 p-4 rounded-xl bg-surface-container-high border border-primary/10">
                <div class="w-12 h-12 rounded-lg bg-tertiary-container text-white flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-[24px]">e911_emergency</span>
                </div>
                <div>
                  <span class="text-xs uppercase tracking-wider font-bold text-secondary block">Ligne d'Urgence Directe (GSM)</span>
                  <a href="tel:+32470552020" class="font-headline-sm text-xl text-tertiary-container font-extrabold hover:underline">
                    0470 / 55 20 20
                  </a>
                  <p class="text-xs text-secondary mt-0.5">Technicien de garde de nuit et week-end</p>
                </div>
              </div>

              <!-- WhatsApp -->
              <div class="flex items-start gap-4 p-4 rounded-xl bg-surface-container-high border border-primary/10">
                <div class="w-12 h-12 rounded-lg bg-primary-container text-white flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-[24px]">chat</span>
                </div>
                <div>
                  <span class="text-xs uppercase tracking-wider font-bold text-secondary block">Diagnostic Photo Express</span>
                  <a
                    href="https://wa.me/32470552020?text=Bonjour,%20j'ai%20une%20urgence%20plomberie%20à%20Mons"
                    target="_blank"
                    rel="noopener"
                    class="font-headline-sm text-lg text-primary font-bold hover:underline"
                  >
                    Envoyer une photo par WhatsApp
                  </a>
                  <p class="text-xs text-secondary mt-0.5">Réponse instantanée avec pré-diagnostic chiffré</p>
                </div>
              </div>

              <!-- Location & Mail -->
              <div class="pt-2 space-y-2 text-sm text-on-surface-variant">
                <div class="flex items-center gap-2.5">
                  <span class="material-symbols-outlined text-primary-container text-[20px]">location_on</span>
                  <span>Rue de la Chaussée 42, 7000 Mons, Belgique</span>
                </div>
                <div class="flex items-center gap-2.5">
                  <span class="material-symbols-outlined text-primary-container text-[20px]">mail</span>
                  <a href="mailto:contact@plombiermonsurgent.be" class="hover:underline">contact@plombiermonsurgent.be</a>
                </div>
                <div class="flex items-center gap-2.5">
                  <span class="material-symbols-outlined text-primary-container text-[20px]">schedule</span>
                  <span>Ouvert 24h/24, 7j/7 sans interruption</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Emergency First-Aid Checklist -->
          <div class="p-6 md:p-8 rounded-2xl bg-surface-container-high border border-primary/10 space-y-4">
            <div class="flex items-center gap-2 text-tertiary-container font-bold text-sm">
              <span class="material-symbols-outlined text-[22px]">warning</span>
              <span>Que faire en attendant notre arrivée ?</span>
            </div>
            <ul class="space-y-2.5 text-xs md:text-sm text-on-surface leading-relaxed">
              <li class="flex items-start gap-2">
                <span class="font-bold text-primary">1.</span>
                <span><strong>Coupez l'arrivée générale d'eau</strong> (située généralement près du compteur d'eau dans la cave ou au garage).</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-bold text-primary">2.</span>
                <span><strong>Coupez l'alimentation électrique du boiler</strong> si celui-ci fuit ou si l'eau s'écoule près d'une prise.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-bold text-primary">3.</span>
                <span><strong>N'utilisez aucun produit corrosif chimique</strong> dans un WC ou un évier bouché (cela risque de brûler nos techniciens et de détériorer les tuyaux).</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-bold text-primary">4.</span>
                <span><strong>Prenez des photos de la fuite</strong> pour constituer votre dossier d'assurance habitation.</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Form Column -->
        <div class="lg:col-span-6">
          <QuoteForm
            title="Formulaire de Devis & Contact"
            subtitle="Décrivez votre besoin. Un artisan de Mons vous répond en 15 minutes."
          />
        </div>
      </div>
    </div>
  </section>
</Layout>
