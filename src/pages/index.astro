---
import Layout from '../layouts/Layout.astro';
import TrustBar from '../components/TrustBar.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import ReviewBadges from '../components/ReviewBadges.astro';
import ResponseTimeStats from '../components/ResponseTimeStats.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import TrustBadgesSection from '../components/TrustBadgesSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';

const services = [
  {
    icon: 'e911_emergency',
    tag: 'Urgence 24/7',
    title: "Dépannage d'Urgence Plomberie 24h/24",
    desc: "Intervention en 30 à 45 minutes pour tuyau percé, inondation, coupure d'eau et mise en sécurité immédiate de votre logement.",
    link: '/services/depannage-urgence',
    badge: 'Sur Place en 30 min',
    image: '/images/depannage-urgence-mons.webp'
  },
  {
    icon: 'plumbing',
    tag: 'Haute Pression',
    title: 'Débouchage Canalisations, WC & Égouts',
    desc: "Intervention d'urgence furet électrique et hydrocureuse 200 bars. Égouts, toilettes, sterputs extérieurs et vidange fosse septique.",
    link: '/services/debouchage',
    badge: 'Caméra HD Incluse',
    image: '/images/debouchage-haute-pression.webp'
  },
  {
    icon: 'water_damage',
    tag: 'Non Destructif',
    title: "Recherche de Fuite d'Eau Non Destructive",
    desc: 'Localisation acoustique et caméra thermique FLIR sans casser vos murs. Rapport technique complet fourni pour votre assurance habitation.',
    link: '/services/detection-fuites',
    badge: '100% Remboursé Assurance',
    image: '/images/detection-fuites-mons.webp'
  },
  {
    icon: 'mode_heat',
    tag: 'Agréé Gaz',
    title: 'Chauffagiste & Chaudière Gaz CERGA',
    desc: "Dépannage chaudière gaz, dépannage boiler et entretien périodique obligatoire en Wallonie avec délivrance de l'attestation légale.",
    link: '/services/chauffage-chaudieres',
    badge: 'Habilité Wallonie G1/G2',
    image: '/images/chauffage-chaudiere-cerga.webp'
  },
  {
    icon: 'wash',
    tag: 'Sanitaire & SDB',
    title: 'Installations Sanitaires & Rénovation Salle de Bain',
    desc: 'Rénovation complète, pose de WC suspendus Geberit, douches à l\'italienne et robinetterie Grohe/Hansgrohe. TVA 6%.',
    link: '/services/installations-sanitaires',
    badge: 'Garantie Décennale',
    image: '/images/installations-sanitaires-sdb.webp'
  },
  {
    icon: 'water_bottle',
    tag: 'Anti-Calcaire',
    title: 'Traitement de l\'Eau & Adoucisseurs',
    desc: "L'eau SWDE à Mons est très dure (35°F). Protégez vos tuyauteries, sanitaires et boilers avec nos adoucisseurs volumétriques ou sans électricité.",
    link: '/services/traitement-eau',
    badge: 'Économies d\'Énergie',
    image: '/images/traitement-eau-adoucisseur.webp'
  }
];


const problems = [
  { name: 'Fuite d\'eau sur tuyau ou sous carrelage', icon: 'water_drop', solution: 'Détection sans casse & colmatage immédiat' },
  { name: 'WC ou toilette suspendue bouchée', icon: 'toilet', solution: 'Débouchage furet pro sans endommager l\'émail' },
  { name: 'Refoulement d\'égout ou odeurs nauséabondes', icon: 'masks', solution: 'Inspection caméra & curage haute pression' },
  { name: 'Sterput de cour ou siphon bouché', icon: 'filter_drama', solution: 'Hydrocurage puissant évacuations extérieures' },
  { name: 'Boiler en panne ou plus d\'eau chaude', icon: 'device_thermostat', solution: 'Diagnostic résistance, thermostat & détartrage' },
  { name: 'Chaudière gaz en sécurité / en panne', icon: 'error', solution: 'Dépannage d\'urgence par chauffagiste CERGA' }
];

const reviews = [
  {
    author: 'Marc Vandevelde',
    location: 'Mons Centre (7000)',
    rating: 5,
    date: 'Intervention le 14 février 2026',
    comment: 'Fuite sous évier un dimanche matin. Un plombier de chez Plombier Mons Urgent est arrivé en 35 minutes chrono. Devis annoncé au départ respecté au centime près. Vraiment rassurant de voir un artisan sérieux qui n\'abuse pas sur les prix.'
  },
  {
    author: 'Nathalie Liénard',
    location: 'Jemappes (7012)',
    rating: 5,
    date: 'Intervention le 2 février 2026',
    comment: 'Sterput extérieur totalement bouché avec l\'eau qui remontait vers la buanderie. Ils ont passé la caméra et débloqué avec leur camion haute pression en 45 min. Travail impeccable, propre et efficace.'
  },
  {
    author: 'Jean-Luc Dubois',
    location: 'Cuesmes (7033)',
    rating: 5,
    date: 'Intervention le 19 janvier 2026',
    comment: 'Recherche de fuite dans le mur du salon. Équipé d\'une caméra thermique, le technicien a trouvé la fuite exacte en 15 minutes sans casser. Le rapport pour mon assurance Ethias a été accepté sans discussion.'
  }
];
---

<Layout
  title="Plombier Mons Urgent | Dépannage Plomberie 24h/24 & Débouchage en 30 Min"
  description="Plombier certifié à Mons (7000) et Borinage. Dépannage en 30 min 24h/24 : fuite d'eau, débouchage WC/sterput, boiler, chaudière CERGA. Devis gratuit : 065 79 40 20."
>
  <!-- 1. HERO SECTION -->
  <section class="relative w-full bg-background overflow-hidden py-10 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Hero Left Content -->
        <div class="lg:col-span-7 flex flex-col items-start space-y-4 md:space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-container-high text-primary font-label-md text-xs md:text-sm font-bold shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-tertiary-container pulse-emergency"></span>
            <span>Permanence Plombier Mons 24h/24 & 7j/7</span>
          </div>

          <h1 class="font-display-hero text-3xl sm:text-4xl lg:text-5xl text-primary tracking-tight font-extrabold leading-tight">
            Plombier à Mons : Dépannage d'Urgence en <span class="text-primary-container underline decoration-tertiary-container decoration-4">30 à 45 Minutes</span>
          </h1>

          <p class="font-body-lg text-base md:text-lg text-on-surface-variant max-w-2xl leading-relaxed">
            Votre artisan plombier local pour tout dépannage urgent dans le <strong>Grand Mons et le Borinage</strong> : fuites d'eau, débouchage canalisation & sterput, panne de boiler et chaudière gaz.
          </p>

          <!-- Key Guarantees Checks -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full pt-1">
            <div class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-primary-container text-[22px]">check_circle</span>
              <span class="text-sm font-semibold text-on-surface">Arrivée rapide en 30 à 45 min sur place</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-primary-container text-[22px]">check_circle</span>
              <span class="text-sm font-semibold text-on-surface">Devis clair validé avant tout début de travail</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-primary-container text-[22px]">check_circle</span>
              <span class="text-sm font-semibold text-on-surface">Artisan agréé CERGA & Région Wallonne</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-primary-container text-[22px]">check_circle</span>
              <span class="text-sm font-semibold text-on-surface">TVA réduite à 6 % (logements &gt; 10 ans)</span>
            </div>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-4 pt-3 w-full">
            <a
              href="tel:+3265794020"
              class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-lg bg-primary-container text-white font-label-lg text-base font-bold hover:bg-forest-dark shadow-md transition-all hover:-translate-y-0.5"
            >
              <span class="material-symbols-outlined text-[22px] text-tertiary-fixed">call</span>
              <span>Appeler le 065 / 79 40 20</span>
            </a>
            <a
              href="https://wa.me/32470552020?text=Bonjour,%20j'ai%20une%20urgence%20plomberie%20à%20Mons"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-lg bg-surface-container-high text-primary font-label-lg text-base font-bold hover:bg-surface-container-highest transition-all border border-primary/10"
            >
              <span class="material-symbols-outlined text-[22px] text-primary-container">chat</span>
              <span>Photo / Devis WhatsApp</span>
            </a>
          </div>

          <!-- Reassurance Footer Note -->
          <div class="pt-1 flex flex-wrap items-center gap-2 text-xs text-secondary font-medium">
            <span class="text-tertiary-container font-bold">⚡ Permanence active</span>
            <span>•</span>
            <span>Mons Centre, Jemappes, Ghlin, Cuesmes, Hyon, Frameries</span>
            <span>•</span>
            <span>N° BCE : BE 0842.195.834</span>
          </div>
        </div>

        <!-- Hero Right Column: Visual + Form -->
        <div class="lg:col-span-5 w-full space-y-5">
          <!-- Above-The-Fold Eager WebP Image (Priority High, Preloaded in Head) -->
          <div class="relative w-full rounded-2xl overflow-hidden shadow-md border border-primary/10 aspect-[16/10] bg-primary">
            <picture>
              <source srcset="/images/hero-plombier-mons.webp" type="image/webp" />
              <img
                src="/images/hero-plombier-mons.webp"
                alt="Plombier Mons Urgent 24/7 - Dépannage en 30 minutes"
                width="800"
                height="500"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="w-full h-full object-cover"
              />
            </picture>
            <div class="absolute bottom-2.5 left-2.5 right-2.5 px-3 py-2 rounded-xl bg-primary/85 backdrop-blur text-white flex items-center justify-between text-xs">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
                <span class="font-bold">Patrouille active Grand Mons</span>
              </div>
              <span class="text-tertiary-fixed font-bold">Arrivée 30 min</span>
            </div>
          </div>

          <QuoteForm
            title="Dépannage Plomberie Immédiat"
            subtitle="Rappel express en moins de 15 minutes par un artisan montois"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. TRUST & CREDENTIALS BAR -->
  <TrustBar />

  <!-- 2b. REVIEW BADGES -->
  <ReviewBadges />

  <!-- 3. COMMON PROBLEMS SOLVER STRIP -->
  <section class="w-full py-16 bg-surface-container-low cv-auto">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Dépannage d'Urgence Immédiat</span>
        <h2 class="font-headline-xl text-2xl md:text-3xl text-primary font-extrabold mt-1">
          Quel est votre problème de plomberie à Mons ?
        </h2>
        <p class="text-sm md:text-base text-on-surface-variant mt-2">
          Nous intervenons immédiatement avec le matériel adéquat pour résoudre votre sinistre sanitaire sans aggraver la situation.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {problems.map((prob) => (
          <div class="p-5 rounded-xl bg-surface-container-lowest border border-primary/10 shadow-sm card-hover-effect flex items-start gap-4">
            <div class="w-12 h-12 rounded-lg bg-surface-container-high flex items-center justify-center text-primary-container shrink-0">
              <span class="material-symbols-outlined text-[26px]">{prob.icon}</span>
            </div>
            <div>
              <h3 class="font-headline-sm text-base text-primary font-bold">{prob.name}</h3>
              <p class="text-xs text-on-surface-variant mt-1">{prob.solution}</p>
              <a href="tel:+3265794020" class="inline-flex items-center gap-1 text-xs font-bold text-primary-container hover:underline mt-2.5">
                <span>Intervenir maintenant</span>
                <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3b. RESPONSE TIME STATS -->
  <ResponseTimeStats />

  <!-- 4. COMPREHENSIVE SERVICES GRID (6 Silos) -->
  <section class="w-full py-16 bg-background cv-auto">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
          <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Prestations Professionnelles</span>
          <h2 class="font-headline-xl text-2xl md:text-4xl text-primary font-extrabold mt-1">
            Nos Services de Plomberie & Dépannage à Mons
          </h2>
        </div>
        <a href="/services" class="inline-flex items-center gap-2 text-sm font-bold text-primary-container hover:underline">
          <span>Voir tous les tarifs & prestations</span>
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((svc) => (
          <div class="p-5 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm card-hover-effect flex flex-col justify-between group">
            <div>
              <!-- Service WebP Image with Native Lazy Loading -->
              <div class="overflow-hidden rounded-xl mb-4 aspect-[16/10] bg-surface-container-high border border-primary/5">
                <picture>
                  <source srcset={svc.image} type="image/webp" />
                  <img
                    src={svc.image}
                    alt={svc.title}
                    width="600"
                    height="375"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </picture>
              </div>

              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="px-2.5 py-1 rounded-full bg-surface-container-high text-primary font-bold text-xs">
                  {svc.tag}
                </span>
                <span class="text-[11px] font-bold text-tertiary-container bg-tertiary-fixed px-2 py-0.5 rounded">
                  {svc.badge}
                </span>
              </div>

              <h3 class="font-headline-sm text-base md:text-lg text-primary font-bold leading-snug">{svc.title}</h3>
              <p class="text-xs md:text-sm text-on-surface-variant mt-2 leading-relaxed">{svc.desc}</p>
            </div>
            <div class="pt-5 mt-4 border-t border-primary/5 flex items-center justify-between">
              <a href={svc.link} class="text-xs font-bold text-primary-container hover:underline flex items-center gap-1">
                <span>En savoir plus</span>
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
              </a>
              <a href="tel:+3265794020" class="text-xs font-bold text-secondary hover:text-primary flex items-center gap-1">
                <span class="material-symbols-outlined text-[16px]">call</span>
                <span>065 / 79 40 20</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. EMERGENCY BANNER -->
  <section class="w-full bg-primary-container text-white py-12">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="space-y-2 text-center lg:text-left">
          <span class="text-xs uppercase tracking-widest font-extrabold text-tertiary-fixed">Fuite d'eau ou inondation en cours ?</span>
          <h2 class="font-headline-xl text-2xl md:text-3xl text-white font-extrabold">
            Un technicien d'urgence peut être chez vous dans 30 minutes
          </h2>
          <p class="text-sm text-on-primary-container max-w-2xl">
            Ne laissez pas une fuite dégrader vos planchers ou vos plafonds. Coupez l'arrivée générale et contactez notre permanence téléphonique immédiatement.
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-4 shrink-0">
          <a
            href="tel:+3265794020"
            class="px-6 py-3.5 rounded-lg bg-white text-primary font-bold text-base shadow hover:bg-surface-container transition-all flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-[22px] text-primary-container">call</span>
            <span>065 / 79 40 20</span>
          </a>
          <a
            href="tel:+32470552020"
            class="px-6 py-3.5 rounded-lg bg-tertiary-container text-white font-bold text-base shadow hover:bg-tertiary transition-all flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-[22px]">bolt</span>
            <span>SOS 0470 / 55 20 20</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. WHY CHOOSE US (ANTI-SCAM CHARTER) -->
  <section class="w-full py-16 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">La Charte Confiance & Zéro Arnaque</span>
        <h2 class="font-headline-xl text-2xl md:text-4xl text-primary font-extrabold mt-1">
          Pourquoi faire confiance à Plombier Mons Urgent ?
        </h2>
        <p class="text-sm md:text-base text-on-surface-variant mt-2">
          Le secteur du dépannage souffre de trop d'abus tarifaires. Nous avons bâti notre réputation sur la transparence absolue et le professionnalisme d'artisans montois déclarés.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-primary mb-4">
            <span class="material-symbols-outlined text-[26px]">home_pin</span>
          </div>
          <h3 class="font-headline-sm text-lg text-primary font-bold">100% Local Montois</h3>
          <p class="text-sm text-on-surface-variant mt-2">
            Pas de centrale d'appel bruxelloise ni d'intermédiaire qui sous-traite. Nos dépanneurs partent directement de Mons pour intervenir chez vous.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-primary mb-4">
            <span class="material-symbols-outlined text-[26px]">request_quote</span>
          </div>
          <h3 class="font-headline-sm text-lg text-primary font-bold">Devis Signé Avant Travaux</h3>
          <p class="text-sm text-on-surface-variant mt-2">
            Aucune mauvaise surprise : le tarif est fixé et validé avec vous avant que le moindre outil ne touche vos canalisations.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-primary mb-4">
            <span class="material-symbols-outlined text-[26px]">verified</span>
          </div>
          <h3 class="font-headline-sm text-lg text-primary font-bold">Agréé CERGA & Région Wallonne</h3>
          <p class="text-sm text-on-surface-variant mt-2">
            Techniciens qualifiés, habilités pour le gaz en Wallonie, avec délivrance des attestations légales pour vos contrôles périodiques.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-primary mb-4">
            <span class="material-symbols-outlined text-[26px]">receipt</span>
          </div>
          <h3 class="font-headline-sm text-lg text-primary font-bold">Dossier Assurance Incendie</h3>
          <p class="text-sm text-on-surface-variant mt-2">
            En cas de dégât des eaux, nous rédigeons un rapport technique conforme aux exigences des compagnies d'assurance belges (Ethias, AXA, AG).
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-primary mb-4">
            <span class="material-symbols-outlined text-[26px]">shield_with_heart</span>
          </div>
          <h3 class="font-headline-sm text-lg text-primary font-bold">Garantie Pièces & Main d'Œuvre</h3>
          <p class="text-sm text-on-surface-variant mt-2">
            Toutes nos réparations et installations sont couvertes par notre garantie de 2 ans, ainsi que par notre responsabilité civile décennale.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-primary mb-4">
            <span class="material-symbols-outlined text-[26px]">percent</span>
          </div>
          <h3 class="font-headline-sm text-lg text-primary font-bold">TVA Réduite à 6 %</h3>
          <p class="text-sm text-on-surface-variant mt-2">
            Application directe du taux de TVA belge de 6 % pour les logements de plus de 10 ans, pour alléger le coût de vos travaux de rénovation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. PROCESS CARDS (4 STEPS) -->
  <section class="w-full py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Méthode d'Intervention</span>
        <h2 class="font-headline-xl text-2xl md:text-3xl text-primary font-extrabold mt-1">
          Comment se déroule votre dépannage à Mons ?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm relative overflow-hidden">
          <span class="text-6xl font-extrabold text-primary/5 absolute top-2 right-4">01</span>
          <div class="w-10 h-10 rounded-lg bg-primary-container text-white flex items-center justify-center font-bold text-base mb-4">1</div>
          <h3 class="font-headline-sm text-base text-primary font-bold">Appel & Triage d'Urgence</h3>
          <p class="text-xs text-on-surface-variant mt-2 leading-relaxed">
            Vous nous décrivez la panne par téléphone ou WhatsApp. Un technicien d'astreinte est immédiatement déployé vers votre adresse.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm relative overflow-hidden">
          <span class="text-6xl font-extrabold text-primary/5 absolute top-2 right-4">02</span>
