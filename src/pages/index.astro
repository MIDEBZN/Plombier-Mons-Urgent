---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  title="Plombier Mons (7000) Dépannage Urgent 24/7 en 20-30 min | Plombier Mons Urgent"
  description="Besoin d'un vrai plombier à Mons ? Intervention d'urgence en 20 à 30 min 24h/24 & 7j/7 dans le Grand Mons et le Borinage. Devis gratuit sans surprise. 065 70 03 87."
  canonicalPath=""
  currentPage="accueil"
>
  <!-- 1. HERO SECTION -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-grid">
        <!-- Hero Left Column -->
        <div class="hero-content">
          <!-- Live Status Badge -->
          <div class="badge-live">
            <span class="pulse-dot"></span>
            <span>PLOMBIER DISPONIBLE 24H/24 ET 7J/7 DANS LE GRAND MONS</span>
          </div>

          <!-- Main H1 -->
          <h1 class="hero-title">
            Plombier à <span class="text-teal">Mons</span> : Dépannage urgent chez vous en <span class="text-teal">20 à 30 minutes</span>
          </h1>

          <!-- Value Statement -->
          <p class="hero-desc">
            Fuite d'eau, canalisation ou WC bouché, panne de chaudière ou de boiler ? Notre équipe d'artisans montois qualifiés intervient jour et nuit avec devis clair avant tout travail. Un vrai professionnel local, sans intermédiaire ni centrale d'appel lointaine.
          </p>

          <!-- CTAs -->
          <div class="hero-actions">
            <a href="tel:065700387" class="btn-primary hero-btn-main">
              <span class="material-symbols-outlined icon-24">phone_in_talk</span>
              <span>Appeler maintenant (065 70 03 87)</span>
            </a>
            <a href="https://wa.me/3265700387" class="btn-secondary hero-btn-sub" target="_blank" rel="noopener noreferrer">
              <span class="material-symbols-outlined icon-22 text-teal">chat</span>
              <span>WhatsApp Devis Rapide</span>
            </a>
          </div>

          <!-- Reassurance Signals -->
          <div class="hero-signals">
            <div class="signal-item">
              <span class="material-symbols-outlined signal-icon">timer</span>
              <span class="signal-text">Arrivée en 20-30 min</span>
            </div>
            <div class="signal-item">
              <span class="material-symbols-outlined signal-icon">receipt_long</span>
              <span class="signal-text">Devis écrit avant travaux</span>
            </div>
            <div class="signal-item">
              <span class="material-symbols-outlined signal-icon">verified</span>
              <span class="signal-text">Agréé CERGA & PEB</span>
            </div>
            <div class="signal-item">
              <span class="material-symbols-outlined signal-icon star">star</span>
              <span class="signal-text">4.9 / 5 (340+ avis vérifiés)</span>
            </div>
          </div>
        </div>

        <!-- Hero Right Column : Formulaire Rapide -->
        <div class="hero-form-wrapper">
          <ContactForm
            title="Dépannage d'Urgence ou Devis Gratuit"
            subtitle="Remplissez ce formulaire : un plombier vous rappelle sous 5 minutes."
            id="devis"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. TRUST STATS STRIP -->
  <section class="trust-strip">
    <div class="container">
      <div class="trust-grid">
        <div class="trust-stat-box">
          <div class="stat-top">
            <span class="material-symbols-outlined star-icon">star</span>
            <span class="stat-num">4.9 / 5</span>
          </div>
          <span class="stat-sub">Avis clients locaux vérifiés</span>
        </div>
        <div class="trust-stat-box">
          <div class="stat-top">
            <span class="material-symbols-outlined stat-icon">speed</span>
            <span class="stat-num">20 à 30 min</span>
          </div>
          <span class="stat-sub">Délai moyen d'arrivée sur Mons</span>
        </div>
        <div class="trust-stat-box">
          <div class="stat-top">
            <span class="material-symbols-outlined stat-icon alert">emergency</span>
            <span class="stat-num">24h/24 - 7j/7</span>
          </div>
          <span class="stat-sub">Nuits, dimanches et fériés</span>
        </div>
        <div class="trust-stat-box">
          <div class="stat-top">
            <span class="material-symbols-outlined stat-icon">task_alt</span>
            <span class="stat-num">0 EUR Devis</span>
          </div>
          <span class="stat-sub">Prix validé avant tout geste</span>
        </div>
        <div class="trust-stat-box">
          <div class="stat-top">
            <span class="material-symbols-outlined stat-icon">shield</span>
            <span class="stat-num">Garantie 2 ans</span>
          </div>
          <span class="stat-sub">Pièces et main-d'œuvre</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. SERVICES SECTION -->
  <section class="section-py services-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag">INTERVENTIONS EXPERTES</span>
        <h2 class="section-title">Nos Services de Plomberie et Dépannage à Mons</h2>
        <p class="section-desc">
          Une équipe réactive et certifiée pour résoudre l'ensemble de vos problèmes sanitaires et de chauffage dans le Hainaut.
        </p>
      </div>

      <div class="grid-3">
        <!-- Service Card 1 -->
        <div class="card service-card">
          <div class="service-icon-box">
            <span class="material-symbols-outlined">water_damage</span>
          </div>
          <h3 class="service-card-title">Dépannage Fuite d'Eau</h3>
          <p class="service-card-desc">
            Intervention d'urgence sur canalisation percée, robinetterie cassée, raccord sous évier et fuite de chasse d'eau encastrée Geberit.
          </p>
          <a href="/services#fuites" class="service-card-link">
            <span>En savoir plus</span>
            <span class="material-symbols-outlined link-arr">arrow_forward</span>
          </a>
        </div>

        <!-- Service Card 2 -->
        <div class="card service-card">
          <div class="service-icon-box">
            <span class="material-symbols-outlined">cleaning_services</span>
          </div>
          <h3 class="service-card-title">Débouchage Haute Pression</h3>
          <p class="service-card-desc">
            Débouchage WC, évier, baignoire, sterput de garage et colonnes d'immeubles. Hydrocurage 300 bars et caméra d'inspection sans casse.
          </p>
          <a href="/services#debouchage" class="service-card-link">
            <span>En savoir plus</span>
            <span class="material-symbols-outlined link-arr">arrow_forward</span>
          </a>
        </div>

        <!-- Service Card 3 -->
        <div class="card service-card">
          <div class="service-icon-box">
            <span class="material-symbols-outlined">search_check</span>
          </div>
          <h3 class="service-card-title">Recherche de Fuite Non Destructive</h3>
          <p class="service-card-desc">
            Localisation au millimètre par caméra thermique infrarouge, gaz traceur et sonde acoustique. Rapport officiel agréé assurances fourni.
          </p>
          <a href="/services#fuites" class="service-card-link">
            <span>En savoir plus</span>
            <span class="material-symbols-outlined link-arr">arrow_forward</span>
          </a>
        </div>

        <!-- Service Card 4 -->
        <div class="card service-card">
          <div class="service-icon-box">
            <span class="material-symbols-outlined">mode_heat</span>
          </div>
          <h3 class="service-card-title">Dépannage Chaudière</h3>
          <p class="service-card-desc">
            Chauffagiste agréé CERGA pour chaudières gaz et mazout toutes marques : Bulex, Vaillant, Viessmann, Junkers, Bosch, Remeha.
          </p>
          <a href="/services#chauffage" class="service-card-link">
            <span>En savoir plus</span>
            <span class="material-symbols-outlined link-arr">arrow_forward</span>
          </a>
        </div>

        <!-- Service Card 5 -->
        <div class="card service-card">
          <div class="service-icon-box">
            <span class="material-symbols-outlined">water_heater</span>
          </div>
          <h3 class="service-card-title">Chauffe-Eau & Boiler</h3>
          <p class="service-card-desc">
            Dépannage d'urgence sur panne d'eau chaude, détartrage de cuve et pose de nouveaux boilers électriques ou thermodynamiques en 24h.
          </p>
          <a href="/services#boiler" class="service-card-link">
            <span>En savoir plus</span>
            <span class="material-symbols-outlined link-arr">arrow_forward</span>
          </a>
        </div>

        <!-- Service Card 6 -->
        <div class="card service-card">
          <div class="service-icon-box">
            <span class="material-symbols-outlined">filter_alt</span>
          </div>
          <h3 class="service-card-title">Adoucisseur d'Eau Anti-Calcaire</h3>
          <p class="service-card-desc">
            L'eau du réseau montois est très dure (> 32 degrés français). Installation d'adoucisseurs haute performance pour préserver vos canalisations.
          </p>
          <a href="/services#adoucisseur" class="service-card-link">
            <span>En savoir plus</span>
            <span class="material-symbols-outlined link-arr">arrow_forward</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. COMPETITIVE ADVANTAGE (WHY WE BEAT COMPETITORS) -->
  <section class="section-py bg-light">
    <div class="container">
      <div class="advantage-layout">
        <div>
          <span class="section-tag">LA DIFFÉRENCE MONTOISE</span>
          <h2 class="section-title">Pourquoi les habitants de Mons nous choisissent</h2>
          <p class="section-desc">
            Contrairement aux plateformes d'intermédiation bruxelloises qui vous annoncent 90 à 105 minutes d'attente et facturent des frais de déplacement exorbitants, nous sommes basés directement à Mons.
          </p>

          <div class="advantage-points">
            <div class="adv-point">
              <div class="adv-icon">
                <span class="material-symbols-outlined">pin_drop</span>
              </div>
              <div>
                <h3 class="adv-title">Véritable ancrage local à Mons</h3>
                <p class="adv-text">
                  Nos camionnettes d'intervention patrouillent en continu entre la Grand'Place, Ghlin, Jemappes, Cuesmes et Nimy. Nous arrivons en 20 à 30 minutes chrono.
                </p>
              </div>
            </div>

            <div class="adv-point">
              <div class="adv-icon">
                <span class="material-symbols-outlined">payments</span>
              </div>
              <div>
                <h3 class="adv-title">Tarifs fixes et devis sans mauvaise surprise</h3>
                <p class="adv-text">
                  Rien ne commence avant que vous n'ayez validé notre devis écrit. Pas de facturation abusive de nuit ou de frais de déplacement inventés.
                </p>
              </div>
            </div>

            <div class="adv-point">
              <div class="adv-icon">
                <span class="material-symbols-outlined">handyman</span>
              </div>
              <div>
                <h3 class="adv-title">Stock de pièces d'origine dans le véhicule</h3>
                <p class="adv-text">
                  Raccords laiton, joints, mécanismes Geberit, circulateurs et vannes : 92% de nos dépannages sont résolus dès le premier passage.
                </p>
              </div>
            </div>

            <div class="adv-point">
              <div class="adv-icon">
                <span class="material-symbols-outlined">percent</span>
              </div>
              <div>
                <h3 class="adv-title">TVA réduite à 6% en Wallonie</h3>
                <p class="adv-text">
                  Pour les logements de plus de 10 ans, bénéficiez légalement du taux de TVA à 6% au lieu de 21% sur la main-d'œuvre et les pièces.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="compare-card">
          <h3 class="compare-title">Comparatif des Interventions à Mons</h3>
          <div class="compare-table">
            <div class="compare-row header-row">
              <span>Critère</span>
              <span class="brand-col">Plombier Mons Urgent</span>
              <span class="others-col">Centrales & Autres</span>
            </div>
            <div class="compare-row">
              <span class="crit">Temps d'arrivée</span>
              <span class="brand-val text-teal font-bold">20 à 30 minutes</span>
              <span class="others-val">90 à 105 minutes</span>
            </div>
            <div class="compare-row">
              <span class="crit">Ancrage réel</span>
              <span class="brand-val text-teal font-bold">Mons & Borinage</span>
              <span class="others-val">Bruxelles ou Zaventem</span>
            </div>
            <div class="compare-row">
              <span class="crit">Devis avant travaux</span>
              <span class="brand-val text-teal font-bold">Systématique & ferme</span>
              <span class="others-val">Opacité fréquente</span>
            </div>
            <div class="compare-row">
              <span class="crit">Agréments officiels</span>
              <span class="brand-val text-teal font-bold">CERGA, PEB & Assurance</span>
              <span class="others-val">Variables</span>
            </div>
            <div class="compare-row">
              <span class="crit">Moyens de paiement</span>
              <span class="brand-val text-teal font-bold">Bancontact, Payconiq, Virement</span>
              <span class="others-val">Espèces uniquement parfois</span>
            </div>
          </div>
          <div class="compare-cta">
            <a href="tel:065700387" class="btn-primary w-full">
              <span class="material-symbols-outlined">call</span>
              <span>Demander une intervention immédiate</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. VERIFIED REVIEWS SECTION -->
  <section class="section-py">
    <div class="container">
      <div class="section-header text-center">
        <div class="stars-row">
          <span class="material-symbols-outlined star-icon">star</span>
          <span class="material-symbols-outlined star-icon">star</span>
          <span class="material-symbols-outlined star-icon">star</span>
          <span class="material-symbols-outlined star-icon">star</span>
          <span class="material-symbols-outlined star-icon">star</span>
          <span class="stars-val">4.9 / 5</span>
        </div>
        <h2 class="section-title">Témoignages de nos clients dans le Grand Mons</h2>
        <p class="section-desc">Des retours authentiques de particuliers et commerçants de notre région.</p>
      </div>

      <div class="grid-3">
        <div class="card review-card">
          <div class="stars-mini">
            <span class="material-symbols-outlined star-icon">star</span>
            <span class="material-symbols-outlined star-icon">star</span>
            <span class="material-symbols-outlined star-icon">star</span>
            <span class="material-symbols-outlined star-icon">star</span>
            <span class="material-symbols-outlined star-icon">star</span>
          </div>
          <p class="review-quote">
            "Tuyau d'évacuation fendu un dimanche matin à Jemappes. Le technicien est arrivé en 25 minutes montre en main. Réparation très propre et facture conforme au devis annoncé par téléphone."
          </p>
          <div class="review-author">
            <span class="author-name">Bernard D.</span>
            <span class="author-loc">Jemappes (7012)</span>
          </div>
        </div>

        <div class="card review-card">
          <div class="stars-mini">
            <span class="material-symbols-outlined star-icon">star</span>
            <span class="material-symbols-outlined star-icon">star</span>
            <span class="material-symbols-outlined star-icon">star</span>
            <span class="material-symbols-outlined star-icon">star</span>
            <span class="material-symbols-outlined star-icon">star</span>
          </div>
          <p class="review-quote">
            "WC suspendu Geberit totalement bouché dans notre restaurant du centre-ville. Débouchage express sans rien abîmer grâce à leur furet professionnel. Artisan très poli et efficace."
          </p>
          <div class="review-author">
            <span class="author-name">Émilie R.</span>
            <span class="author-loc">Mons-Centre (7000)</span>
          </div>
        </div>

        <div class="card review-card">
          <div class="stars-mini">
            <span class="material-symbols-outlined star-icon">star</span>
            <span class="material-symbols-outlined star-icon">star</span>
            <span class="material-symbols-outlined star-icon">star</span>
            <span class="material-symbols-outlined star-icon">star</span>
            <span class="material-symbols-outlined star-icon">star</span>
          </div>
          <p class="review-quote">
            "Panne totale sur ma chaudière Bulex en plein mois de décembre. Diagnostic rapide de la sonde de température et remplacement de la pièce immédiatement disponible dans leur camionnette."
          </p>
          <div class="review-author">
            <span class="author-name">Philippe V.</span>
            <span class="author-loc">Ghlin (7011)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. FAQ ACCORDION SECTION -->
  <section class="section-py bg-light">
    <div class="container faq-container">
      <div class="section-header text-center">
        <span class="section-tag">QUESTIONS FRÉQUENTES</span>
        <h2 class="section-title">Tout savoir sur nos dépannages à Mons</h2>
        <p class="section-desc">Transparence totale sur nos délais, tarifs et prises en charge.</p>
      </div>

      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-question">
            <span>Quel est votre délai réel d'intervention en cas d'urgence à Mons ?</span>
            <span class="material-symbols-outlined chevron">expand_more</span>
          </summary>
          <div class="faq-answer">
            Grâce à nos techniciens locaux basés dans l'agglomération de Mons, notre délai moyen d'arrivée est de 20 à 30 minutes pour les urgences avérées (fuite d'eau abondante, WC qui déborde, panne de chauffage en hiver). Lors de votre appel au 065 70 03 87, nous vous confirmons l'heure exacte d'arrivée.
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">
            <span>Comment sont calculés vos tarifs ? Y a-t-il des frais cachés ?</span>
            <span class="material-symbols-outlined chevron">expand_more</span>
          </summary>
          <div class="faq-answer">
            Nos tarifs reposent sur un forfait déplacement et diagnostic transparent, complété par la main-d'œuvre nécessaire. Avant toute réparation ou changement de pièce, l'artisan vous présente un devis écrit détaillé. Aucun travail n'est entrepris sans votre accord formel.
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">
            <span>Intervenez-vous la nuit, le dimanche et les jours fériés ?</span>
            <span class="material-symbols-outlined chevron">expand_more</span>
          </summary>
          <div class="faq-answer">
            Oui. Notre service de garde d'urgence fonctionne 24 heures sur 24, 7 jours sur 7, 365 jours par an. Une équipe d'astreinte est spécifiquement mobilisée pour intervenir en pleine nuit ou les jours fériés sans interruption de service.
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">
            <span>Mes frais de recherche de fuite sont-ils remboursés par mon assurance ?</span>
            <span class="material-symbols-outlined chevron">expand_more</span>
          </summary>
          <div class="faq-answer">
            Dans la grande majorité des contrats d'assurance habitation en Belgique, la recherche de fuite non destructive et les dégâts collatéraux des eaux sont intégralement couverts. Nous vous remettons une facture détaillée et un rapport technique conforme exigé par les experts d'assurance.
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-question">
            <span>Fournissez-vous l'attestation PEB légale lors de l'entretien de chaudière ?</span>
            <span class="material-symbols-outlined chevron">expand_more</span>
          </summary>
          <div class="faq-answer">
            Absolument. En tant que techniciens agréés par la Région Wallonne et certifiés CERGA, nous vous délivrons sur place l'attestation légale de contrôle périodique et le rapport d'analyse de combustion, obligatoires pour votre propriétaire ou votre assurance incendie.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- 7. FINAL EMERGENCY BANNER -->
  <section class="emergency-cta-banner">
    <div class="container text-center">
      <div class="badge-live mb-3">
        <span class="pulse-dot"></span>
        <span>ASTREINTE ACTIVE DANS TOUT LE HAINAUT</span>
      </div>
      <h2 class="banner-title">
        Une fuite d'eau ou une canalisation bouchée ? Ne prenez pas de risque.
      </h2>
      <p class="banner-desc">
        Coupez votre arrivée d'eau générale et contactez notre équipe. Un artisan montois prend la route immédiatement pour sécuriser votre installation.
      </p>
      <div class="banner-actions">
        <a href="tel:065700387" class="btn-primary banner-btn">
          <span class="material-symbols-outlined icon-28">phone_in_talk</span>
          <span>Appeler le 065 70 03 87 (24h/24 & 7j/7)</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Styles */
  .hero-section {
    background: linear-gradient(180deg, var(--surface-container-low) 0%, var(--surface) 100%);
    padding-top: 3.5rem;
    padding-bottom: 4.5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .hero-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: var(--on-surface);
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.1rem;
    }
  }

  .text-teal {
    color: var(--primary-container);
  }

  .hero-desc {
    font-size: 1.05rem;
    color: var(--on-surface-variant);
    line-height: 1.65;
    max-width: 600px;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    padding-top: 0.5rem;
  }

  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  .hero-btn-main {
    padding: 1rem 1.75rem;
    font-size: 1.05rem;
  }

  .hero-btn-sub {
    padding: 1rem 1.5rem;
    font-size: 1rem;
  }

  .hero-signals {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
    width: 100%;
    padding-top: 0.75rem;
  }

  @media (min-width: 640px) {
    .hero-signals {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .signal-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-lg);
    background-color: var(--surface-container-lowest);
    border: 1px solid var(--outline-variant);
    box-shadow: var(--shadow-sm);
  }

  .signal-icon {
    font-size: 18px;
    color: var(--primary-container);
    flex-shrink: 0;
  }

  .signal-icon.star {
    color: #f59e0b;
  }

  .signal-text {
    font-family: var(--font-inter);
    font-size: 0.75rem;
    font-weight: 700;
