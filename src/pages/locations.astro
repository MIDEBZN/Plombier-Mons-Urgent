---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';

const zones = [
  {
    name: "Mons-Centre",
    code: "7000",
    delay: "15 à 20 min",
    details: "Grand'Place, quartier de la Gare Calatrava, Beffroi, Waux-Hall, Marché aux Herbes et boulevards d'enceinte.",
    issues: "Canalisations anciennes en fonte et plomb, accès aux ruelles piétonnes, chasses d'eau encastrées et compteurs d'eau sous voûte.",
    href: "/"
  },
  {
    name: "Ghlin",
    code: "7011",
    delay: "15 à 20 min",
    details: "Centre de Ghlin, zone résidentielle de l'Hippodrome, zoning commercial et axes N56.",
    issues: "Débouchage de sterputs de garage, raccordements pavillonnaires, détartrage de boilers entartrés.",
    href: "/locations/ghlin"
  },
  {
    name: "Jemappes et Flénu",
    code: "7012",
    delay: "10 à 15 min",
    details: "Avenue Maréchal Foch, quartier de la gare de Jemappes, cités ouvrières borines et Flénu centre.",
    issues: "Réseau d'égouttage ancien, refoulements lors de fortes pluies, remplacement de chauffe-eau gaz obsolètes.",
    href: "/locations/jemappes"
  },
  {
    name: "Cuesmes",
    code: "7033",
    delay: "10 à 15 min",
    details: "Centre de Cuesmes, Mont Héribus, chaussée de Frameries et zones pavillonnaires.",
    issues: "Problèmes de calcaire élevé sur chaudières, curage préventif des canalisations et fuites encastrées.",
    href: "/locations/cuesmes"
  },
  {
    name: "Nimy",
    code: "7020",
    delay: "10 à 15 min",
    details: "Nimy centre, Rue des Viaducs, Grand Large, axes N6 vers Soignies.",
    issues: "Nappe haute du canal du Centre, infiltrations en cave, entretien chaudière gaz et débouchage.",
    href: "/locations/nimy"
  },
  {
    name: "Maisières & SHAPE (Casteau)",
    code: "7020",
    delay: "15 à 20 min",
    details: "Maisières village, base militaire du SHAPE / OTAN, villas de Casteau, N6.",
    issues: "Service bilingue français / anglais pour officiers et expatriés, rénovation de salles de bains et entretiens de chaudières.",
    href: "/locations/maisieres-casteau-shape"
  },
  {
    name: "Frameries",
    code: "7080",
    delay: "15 à 20 min",
    details: "Frameries centre, Place d'Armes, Eugies, La Bouverie, Sars-la-Bruyère.",
    issues: "Forte densité d'habitation, calcaire borin à 39°fH, refoulements de colonnes d'égouts, remplacement de boilers.",
    href: "/locations/frameries"
  },
  {
    name: "Quaregnon & Wasmuël",
    code: "7390",
    delay: "15 à 20 min",
    details: "Grand'Place, Rue Jules Destrée, Wasmuël, axes N51 Route de Valenciennes.",
    issues: "Affaissements miniers, contre-pentes d'égout, hydrocurage 350 bars et dépannage chaudières.",
    href: "/locations/quaregnon"
  },
  {
    name: "Saint-Ghislain & Boussu",
    code: "7330, 7300",
    delay: "15 à 20 min",
    details: "Saint-Ghislain centre, Tertre, Hautrage, Sirault, Boussu et Grand-Hornu.",
    issues: "Accès express E19 sortie 25, caves alluviales humides, pompes de relevage et adoucisseurs d'eau.",
    href: "/locations/saint-ghislain"
  }
];
---

<Layout
  title="Zones d'Intervention Plomberie à Mons (7000) et Borinage | Plombier Mons Urgent"
  description="Plombier d'urgence disponible dans toutes les sous-communes de Mons : Ghlin, Jemappes, Cuesmes, Nimy, Havré, Hyon et le Borinage. Arrivée réelle en 20-30 min."
  canonicalPath="/locations"
  currentPage="locations"
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container text-center">
      <div class="badge-tag mb-2">PROXIMITÉ ET RÉACTIVITÉ LOCALE</div>
      <h1 class="page-title">Zones d'Intervention d'Urgence : Mons et Borinage</h1>
      <p class="page-subtitle">
        Nos techniciens sont positionnés en permanence dans l'agglomération montoise pour vous garantir une arrivée en 20 à 30 minutes sans frais d'approche abusifs.
      </p>
    </div>
  </section>

  <!-- Speed Guarantee Strip -->
  <section class="speed-strip">
    <div class="container">
      <div class="speed-box">
        <div class="speed-icon-wrap">
          <span class="material-symbols-outlined speed-icon">fmd_good</span>
        </div>
        <div class="speed-content">
          <h2 class="speed-title">Pourquoi notre délai est de 20-30 min (et pas 90-105 min comme d'autres) ?</h2>
          <p class="speed-desc">
            De nombreux sites web concurrents prétendent être à Mons alors que leurs véhicules partent en réalité de Bruxelles, Zaventem ou Braine-l'Alleud. En cas d'inondation active ou de refoulement d'égout, attendre 1h30 à 2h peut détruire votre parquet et vos plafonds. Chez <strong>Plombier Mons Urgent</strong>, notre équipe opère exclusivement dans le bassin du Hainaut montois.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Local Zones Grid -->
  <section class="section-py">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag">DESSERTE DÉTAILLÉE</span>
        <h2 class="section-title">Communes et Quartiers Pris en Charge 24h/24</h2>
        <p class="section-desc">
          Cliquez sur votre secteur ou appelez directement notre régulation pour bloquer le véhicule le plus proche.
        </p>
      </div>

      <div class="grid-2 zones-grid">
        {zones.map((zone) => (
          <div class="card zone-card">
            <div class="zone-top">
              <div>
                <span class="zone-code">Code postal : {zone.code}</span>
                <h3 class="zone-name">{zone.name}</h3>
              </div>
              <div class="zone-delay-pill">
                <span class="pulse-dot teal"></span>
                <span>{zone.delay}</span>
              </div>
            </div>
            <div class="zone-body">
              <div class="zone-meta-block">
                <strong>Secteurs clés couverts :</strong>
                <p>{zone.details}</p>
              </div>
              <div class="zone-meta-block">
                <strong>Spécificités techniques courantes :</strong>
                <p>{zone.issues}</p>
              </div>
            </div>
            <div class="zone-footer" style="display: flex; flex-direction: column; gap: 0.5rem;">
              {zone.href && (
                <a href={zone.href} class="btn-outline w-full" style="justify-content: center; font-size: 0.85rem; padding: 0.6rem 1rem;">
                  <span class="material-symbols-outlined">explore</span>
                  <span>Guide & Itinéraires : {zone.name}</span>
                </a>
              )}
              <a href="tel:065700387" class="btn-primary w-full" style="justify-content: center;">
                <span class="material-symbols-outlined">call</span>
                <span>Appeler pour {zone.name} (065 70 03 87)</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Special NATO / SHAPE Bilingual Box -->
  <section class="section-py bg-light">
    <div class="container" style="max-width: 960px;">
      <div class="shape-bilingual-card">
        <div class="shape-header">
          <span class="material-symbols-outlined shape-icon">language</span>
          <div>
            <span class="badge-tag">NATO / OTAN - SHAPE MAISIÈRES</span>
            <h2 class="shape-title">English-Speaking Plumbers in Mons & Maisières</h2>
          </div>
        </div>
        <p class="shape-desc">
          Are you stationed at SHAPE (Supreme Headquarters Allied Powers Europe) or living in Mons, Maisières, Nimy or Jurbise? Our certified plumbing and heating technicians speak fluent English. We handle emergency leak repairs, boiler breakdowns, bathroom installations, and official invoices for reimbursement.
        </p>
        <div class="shape-actions">
          <a href="tel:065700387" class="btn-primary">
            <span class="material-symbols-outlined">call</span>
            <span>Emergency English Line: 065 70 03 87</span>
          </a>
          <a href="https://wa.me/3265700387" class="btn-secondary" target="_blank" rel="noopener noreferrer">
            <span class="material-symbols-outlined text-teal">chat</span>
            <span>WhatsApp in English</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Fast Lead Form Section -->
  <section class="section-py">
    <div class="container" style="max-width: 820px;">
      <ContactForm
        title="Vérifier la Disponibilité Immédiate d'un Véhicule"
        subtitle="Sélectionnez votre commune dans le Grand Mons : un artisan vous confirme le délai en 5 minutes."
      />
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(180deg, var(--surface-container-low) 0%, var(--surface) 100%);
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid var(--outline-variant);
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--on-surface);
    margin: 0.5rem 0;
  }

  @media (min-width: 768px) {
    .page-title {
      font-size: 2.85rem;
    }
  }

  .page-subtitle {
    font-size: 1.05rem;
    color: var(--on-surface-variant);
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .speed-strip {
    background-color: var(--surface-container-low);
    padding: 2rem 0;
    border-bottom: 1px solid var(--outline-variant);
  }

  .speed-box {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background-color: var(--surface-container-lowest);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-2xl);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 768px) {
    .speed-box {
      flex-direction: row;
      align-items: center;
    }
  }

  .speed-icon-wrap {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-xl);
    background-color: var(--surface-container-low);
    color: var(--primary-container);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .speed-icon {
    font-size: 32px;
  }

  .speed-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--on-surface);
    margin-bottom: 0.4rem;
  }

  .speed-desc {
    font-size: 0.95rem;
    color: var(--on-surface-variant);
    line-height: 1.6;
  }

  /* Zones Grid */
  .zones-grid {
    gap: 1.75rem;
  }

  .zone-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 2rem;
  }

  .zone-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid var(--outline-variant);
    padding-bottom: 1rem;
  }

  .zone-code {
    font-family: var(--font-inter);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--primary-container);
    text-transform: uppercase;
  }

  .zone-name {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--on-surface);
  }

  .zone-delay-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    background-color: var(--surface-container-low);
    border: 1px solid rgba(0, 128, 128, 0.25);
    font-family: var(--font-inter);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--on-surface);
  }

  .zone-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .zone-meta-block strong {
    display: block;
    font-family: var(--font-inter);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--on-surface);
    margin-bottom: 0.2rem;
  }

  .zone-meta-block p {
    font-size: 0.9rem;
    color: var(--on-surface-variant);
    line-height: 1.5;
  }

  .zone-footer {
    padding-top: 0.5rem;
  }

  /* SHAPE Bilingual Card */
  .shape-bilingual-card {
    background-color: var(--surface-container-lowest);
    border: 2px solid var(--primary-container);
    border-radius: var(--radius-2xl);
    padding: 2.5rem;
    box-shadow: var(--shadow-xl);
  }

  .shape-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .shape-icon {
    font-size: 36px;
    color: var(--primary-container);
  }

  .shape-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--on-surface);
    margin-top: 0.25rem;
  }

  .shape-desc {
    font-size: 1rem;
    color: var(--on-surface-variant);
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  .shape-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .shape-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  .mb-2 {
    margin-bottom: 0.5rem;
  }
</style>
