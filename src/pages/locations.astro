---
import Layout from '../layouts/Layout.astro';
import TrustBar from '../components/TrustBar.astro';

const locationsList = [
  {
    postal: '7000',
    city: 'Mons Centre',
    delay: '25 à 35 min',
    coverage: 'Grand-Place, Beffroi, Waux-Hall, Avenue Frère Orban, Boulevard Dolez, Gare de Mons',
    desc: 'Intervention d\'urgence dans le centre historique de Mons et ses immeubles classés ou récents. Remplacement de canalisations anciennes, dépannage de chauffe-eau et débouchage WC sans nuisance.',
    specialty: 'Rénovation sur tuyauteries anciennes et intervention discrète en centre-ville'
  },
  {
    postal: '7011',
    city: 'Ghlin',
    delay: '30 min',
    coverage: 'Chaussée de Ghlin, Hippodrome de Wallonie, zone artisanale et résidentielle',
    desc: 'Permanence rapide pour les résidences pavillonnaires et entreprises à Ghlin. Dépannage fuites d\'eau, entretien annuel de chaudières gaz CERGA et pose d\'adoucisseurs d\'eau.',
    specialty: 'Pose d\'adoucisseurs d\'eau anti-calcaire pour maisons individuelles'
  },
  {
    postal: '7012',
    city: 'Jemappes & Flénu',
    delay: '30 min',
    coverage: 'Avenue Maréchal Foch, zone commerciale Cora, abords du canal et cité ouvrière',
    desc: 'Intervention d\'hydrocurage pour canalisations bouchées, sterputs extérieurs et dépannage urgent de plomberie sanitaire à Jemappes et Flénu.',
    specialty: 'Débouchage haute pression de sterputs et canalisations d\'évacuation'
  },
  {
    postal: '7033',
    city: 'Cuesmes',
    delay: '30 min',
    coverage: 'Maison Van Gogh, Mont Héribus, zone basse de Cuesmes et axes de liaison',
    desc: 'Le relief de Cuesmes entraîne des refoulements d\'égouts fréquents lors de fortes pluies. Nous intervenons avec notre caméra d\'inspection et installons des clapets anti-retour pour protéger les caves.',
    specialty: 'Installation de clapets anti-refoulement et pompes de relevage'
  },
  {
    postal: '7020',
    city: 'Nimy & Maisières',
    delay: '35 min',
    coverage: 'Grand-Large, SHAPE, route de Bruxelles, zones résidentielles calmes',
    desc: 'Dépannage plomberie bilingue (français / anglais pour expatriés et personnel SHAPE). Remplacement robinetterie haut de gamme, dépannage chauffe-eau et détartrage.',
    specialty: 'Interventions soignées résidences haut de gamme et conformité européenne'
  },
  {
    postal: '7021',
    city: 'Havré & Saint-Symphorien',
    delay: '35 min',
    coverage: 'Château d\'Havré, Chaussée du Roeulx, village de Saint-Symphorien',
    desc: 'Détection de fuite non destructive, remplacement de colonnes de décharge et travaux de rénovation de salle de bain clé en main.',
    specialty: 'Recherche de fuite par caméra thermique et rapport d\'assurance'
  },
  {
    postal: '7022',
    city: 'Hyon, Mesvin & Spiennes',
    delay: '35 min',
    coverage: 'Chaussée de Hyon, vallée de la Trouille, sites néolithiques de Spiennes, Harmignies',
    desc: 'Eau particulièrement dure sur ce secteur calcaire. Nous assurons la maintenance des chauffe-eau et la pose d\'adoucisseurs d\'eau pour éliminer le tartre incrusté.',
    specialty: 'Détartrage boiler électrique et traitement de l\'eau calcaire'
  },
  {
    postal: '7080 - 7390',
    city: 'Frameries & le Borinage',
    delay: '35 à 45 min',
    coverage: 'Frameries, Quaregnon, Saint-Ghislain, Boussu, Dour, Colfontaine',
    desc: 'Couverture complète de l\'ensemble du bassin borain pour les urgences plomberie, débouchages d\'égouts et pannes de chauffage chez les particuliers et commerçants.',
    specialty: 'Dépannage urgent 24h/7 dans tout le Borinage avec devis clair avant travaux'
  }
];
---

<Layout
  title="Zones d'Intervention Plomberie Mons & Borinage | Dépannage 30 Min"
  description="Consultez nos zones de dépannage plomberie rapide à Mons : 7000 Mons, 7011 Ghlin, 7012 Jemappes, 7033 Cuesmes, 7022 Hyon, 7080 Frameries et Borinage."
>
  <!-- Page Header -->
  <section class="w-full bg-primary text-white py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 md:px-8 text-center space-y-4">
      <span class="text-xs uppercase tracking-widest font-extrabold text-tertiary-fixed">Déploiement Local Rapide</span>
      <h1 class="font-display-hero text-3xl md:text-5xl text-white font-extrabold tracking-tight">
        Plombier à Mons et dans tout le Borinage
      </h1>
      <p class="text-sm md:text-base text-surface-dim max-w-2xl mx-auto leading-relaxed">
        Nos techniciens d'astreinte sont basés localement à Mons pour intervenir en 30 à 45 minutes réelles dans votre quartier ou commune.
      </p>
    </div>
  </section>

  <TrustBar />

  <!-- Locations Grid -->
  <section class="w-full py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-widest font-extrabold text-primary-container">Couverture Intégrale</span>
        <h2 class="font-headline-xl text-2xl md:text-3xl text-primary font-extrabold mt-1">
          Délais d'intervention et spécificités par commune
        </h2>
        <p class="text-sm md:text-base text-on-surface-variant mt-2">
          Chaque secteur du Grand Mons présente ses propres caractéristiques sanitaires (bâtiments anciens, zones inondables, eau calcaire). Nos artisans connaissent parfaitement le terrain.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {locationsList.map((loc) => (
          <div class="p-6 md:p-8 rounded-2xl bg-surface-container-lowest border border-primary/10 shadow-sm card-hover-effect flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <span class="px-3 py-1 rounded-full bg-surface-container-high text-primary font-extrabold text-xs">
                  CP {loc.postal}
                </span>
                <span class="inline-flex items-center gap-1 text-xs font-bold text-tertiary-container bg-tertiary-fixed px-2.5 py-1 rounded-full">
                  <span class="w-2 h-2 rounded-full bg-tertiary-container pulse-emergency"></span>
                  <span>Arrivée en {loc.delay}</span>
                </span>
              </div>

              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary-container text-[24px]">location_on</span>
                <h3 class="font-headline-sm text-xl text-primary font-bold">{loc.city}</h3>
              </div>

              <p class="text-xs font-semibold text-secondary">
                Secteurs : {loc.coverage}
              </p>

              <p class="text-sm text-on-surface-variant leading-relaxed">
                {loc.desc}
              </p>

              <div class="p-3 rounded-lg bg-surface-container-high border border-primary/10 text-xs text-primary font-semibold">
                ⭐ Spécificité locale : {loc.specialty}
              </div>
            </div>

            <div class="pt-6 mt-4 border-t border-primary/5 flex items-center justify-between">
              <a
                href="tel:+3265794020"
                class="px-4 py-2.5 rounded-lg bg-primary-container text-white font-bold text-xs shadow hover:bg-forest-dark transition-all flex items-center gap-1.5"
              >
                <span class="material-symbols-outlined text-[16px] text-tertiary-fixed">call</span>
                <span>Dépannage à {loc.city}</span>
              </a>
              <span class="text-xs text-secondary font-medium">Dispo 24h/24 & 7j/7</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reassurance CTA -->
  <section class="w-full bg-primary-container text-white py-14">
    <div class="max-w-4xl mx-auto px-4 md:px-8 text-center space-y-4">
      <h2 class="font-headline-xl text-2xl md:text-3xl text-white font-extrabold">
        Votre commune n'est pas dans la liste ci-dessus ?
      </h2>
      <p class="text-sm text-on-primary-container leading-relaxed">
        Nous intervenons également dans toutes les communes du Hainaut limitrophes (Soignies, Binche, Quévy, Erquelinnes, Hensies). Appelez notre permanence pour connaître le délai exact de notre véhicule le plus proche.
      </p>
      <div class="pt-2">
        <a
          href="tel:+3265794020"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-white text-primary font-bold text-base shadow hover:bg-surface-container transition-all"
        >
          <span class="material-symbols-outlined text-[20px] text-primary-container">call</span>
          <span>Permanence Dépannage : 065 / 79 40 20</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
