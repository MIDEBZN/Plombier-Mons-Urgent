---
import Layout from '../../layouts/Layout.astro';
import TrustBar from '../../components/TrustBar.astro';
import ReviewBadges from '../../components/ReviewBadges.astro';
import ResponseTimeStats from '../../components/ResponseTimeStats.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { blogArticles, getRelatedArticles, type BlogArticle } from '../../data/articles';

export async function getStaticPaths() {
  return blogArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: BlogArticle;
}

const { article } = Astro.props;
const relatedArticles = getRelatedArticles(article.slug, 3);

// Category badge color styling
const categoryStyles: Record<string, string> = {
  "Tarifs & Devis": "bg-emerald-500/10 text-emerald-700 border-emerald-500/20",
  "Urgence 24/7": "bg-red-500/10 text-red-700 border-red-500/20",
  "Conseils Pratiques": "bg-blue-500/10 text-blue-700 border-blue-500/20",
  "Débouchage & Fuites": "bg-amber-500/10 text-amber-700 border-amber-500/20",
  "Chauffage & Gaz": "bg-purple-500/10 text-purple-700 border-purple-500/20",
};

const badgeClass = categoryStyles[article.category] || "bg-primary/10 text-primary border-primary/20";

// Article Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.h1,
  "description": article.metaDescription,
  "keywords": [article.primaryKeyword, ...article.secondaryKeywords].join(", "),
  "articleSection": article.category,
  "inLanguage": "fr-BE",
  "datePublished": article.date,
  "dateModified": "2026-09-21",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://www.plombiermonsurgent.be/blog/${article.slug}`
  },
  "author": {
    "@type": "Organization",
    "name": "Plombier Mons Urgent",
    "url": "https://www.plombiermonsurgent.be"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Plombier Mons Urgent",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.plombiermonsurgent.be/logo.png"
    }
  }
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": article.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title={article.title}
  description={article.metaDescription}
  canonicalUrl={`https://www.plombiermonsurgent.be/blog/${article.slug}`}
>
  <!-- SEO Structured Data for Article & FAQs -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Breadcrumbs -->
  <nav aria-label="Fil d'Ariane" class="bg-surface-container-low border-b border-primary/10 py-3">
    <div class="max-w-4xl mx-auto px-4 md:px-8 flex items-center gap-2 text-xs md:text-sm text-on-surface-variant flex-wrap">
      <a href="/" class="hover:text-primary transition-colors">Accueil</a>
      <span>/</span>
      <a href="/blog" class="hover:text-primary transition-colors">Blog & Guides</a>
      <span>/</span>
      <span class="text-primary font-bold truncate max-w-xs md:max-w-md">{article.title}</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <header class="w-full bg-primary text-white py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 md:px-8 space-y-5">
      <div class="flex flex-wrap items-center gap-3">
        <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border ${badgeClass} bg-white text-primary`}>
          <span class="w-2 h-2 rounded-full bg-primary-container pulse-emergency"></span>
          <span>{article.category}</span>
        </span>
        <span class="text-xs text-surface-dim font-medium">⏱️ {article.readTime} de lecture</span>
        <span class="text-xs text-surface-dim font-medium">•</span>
        <span class="text-xs text-surface-dim font-medium">📅 Mis à jour le 21 sept. 2026</span>
      </div>

      <h1 class="font-display-hero text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-white font-extrabold tracking-tight leading-tight">
        {article.h1}
      </h1>

      <p class="text-sm md:text-base text-surface-dim max-w-3xl leading-relaxed">
        {article.intro}
      </p>

      <!-- Immediate Action Callout in Hero -->
      <div class="pt-3 flex flex-wrap items-center gap-3">
        <a
          href="tel:065794020"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary-container text-white font-bold text-sm shadow-md hover:bg-primary-container/90 transition-all active:scale-95"
        >
          <span class="material-symbols-outlined text-lg">call</span>
          <span>Appeler un Plombier (065 79 40 20)</span>
        </a>
        <a
          href="https://wa.me/32470552020?text=Bonjour%2C%20j%27ai%20besoin%20d%27un%20plombier%20urgent%20%C3%A0%20Mons"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 text-white font-bold text-sm shadow-md hover:bg-emerald-500 transition-all active:scale-95"
        >
          <span class="material-symbols-outlined text-lg">chat</span>
          <span>WhatsApp 24/7 (0470 55 20 20)</span>
        </a>
      </div>
    </div>
  </header>

  <TrustBar />

  <!-- Main Article Section -->
  <article class="w-full py-12 md:py-16 bg-background">
    <div class="max-w-4xl mx-auto px-4 md:px-8 space-y-12">
      
      <!-- AEO & Voice Search Quick Answer Hook -->
      <div class="p-6 md:p-8 rounded-2xl bg-surface-container-high border-2 border-primary-container/30 shadow-sm space-y-3">
        <div class="flex items-center gap-2 text-primary font-extrabold text-sm uppercase tracking-wider">
          <span class="material-symbols-outlined text-primary-container text-[24px]">verified</span>
          <span>Réponse Express (AEO & IA)</span>
        </div>
        <p class="text-sm md:text-base text-on-surface font-semibold leading-relaxed">
          {article.quickAnswer}
        </p>
        <div class="pt-2 flex items-center justify-between text-xs text-on-surface-variant/80 border-t border-primary/10">
          <span>🎯 Mot-clé ciblé : <strong>{article.primaryKeyword}</strong></span>
          <span class="hidden sm:inline">Ville de Mons & Agglomération Borinage</span>
        </div>
      </div>

      <!-- Article Rich Text Body -->
      <div class="article-content prose prose-slate max-w-none text-on-surface-variant leading-relaxed space-y-6">
        <div set:html={article.contentHtml} />
      </div>

      <!-- Direct Phone & WhatsApp Emergency Banner -->
      <div class="p-6 md:p-8 rounded-2xl bg-gradient-to-br from-primary to-primary-container text-white space-y-4 shadow-lg">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="space-y-1">
            <h3 class="text-lg md:text-xl font-extrabold text-white">Une urgence ou un projet de plomberie à Mons ?</h3>
            <p class="text-xs md:text-sm text-surface-dim">Nos artisans qualifiés interviennent en 30 minutes partout à Mons, Cuesmes, Jemappes et Ghlin.</p>
          </div>
          <div class="flex flex-wrap gap-2 sm:gap-3 w-full md:w-auto">
            <a
              href="tel:065794020"
              class="flex-1 sm:flex-none text-center px-4 py-2.5 rounded-xl bg-white text-primary font-bold text-sm shadow hover:bg-surface-dim transition-all"
            >
              📞 065 / 79 40 20
            </a>
            <a
              href="https://wa.me/32470552020?text=Bonjour%2C%20j%27ai%20besoin%20d%27un%20devis%20de%20plomberie%20%C3%A0%20Mons"
              target="_blank"
              rel="noopener"
              class="flex-1 sm:flex-none text-center px-4 py-2.5 rounded-xl bg-emerald-500 text-white font-bold text-sm shadow hover:bg-emerald-400 transition-all"
            >
              💬 WhatsApp Devis
            </a>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <section class="space-y-6 pt-4">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 text-primary text-xs font-bold uppercase tracking-wider">
            <span class="material-symbols-outlined text-sm text-primary-container">help</span>
            <span>Foire Aux Questions</span>
          </div>
          <h2 class="font-headline-sm text-xl md:text-2xl font-extrabold text-on-surface">
            Questions Fréquentes : {article.primaryKeyword}
          </h2>
          <p class="text-xs md:text-sm text-on-surface-variant">
            Retrouvez les réponses de nos plombiers certifiés aux interrogations récurrentes des résidents de la région de Mons.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-4">
          {article.faqs.map((faq, idx) => (
            <div class="p-5 rounded-xl bg-surface-container-lowest border border-primary/10 shadow-sm space-y-2 hover:border-primary/30 transition-all">
              <h3 class="font-headline-sm text-base md:text-lg font-bold text-primary flex items-start gap-2">
                <span class="text-primary-container font-extrabold text-sm mt-0.5">Q{idx + 1}.</span>
                <span>{faq.question}</span>
              </h3>
              <p class="text-xs md:text-sm text-on-surface-variant leading-relaxed pl-6">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Contextual Internal Links Box -->
      {article.internalLinks && article.internalLinks.length > 0 && (
        <section class="p-6 rounded-2xl bg-surface-container-low border border-primary/15 space-y-4">
          <h3 class="font-bold text-sm md:text-base text-primary flex items-center gap-2">
            <span class="material-symbols-outlined text-primary-container">alt_route</span>
            <span>Services et zones d'intervention associés</span>
          </h3>
          <div class="flex flex-wrap gap-2">
            {article.internalLinks.map((link) => (
              <a
                href={link.url}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-lowest border border-primary/10 text-xs md:text-sm font-semibold text-primary hover:bg-primary hover:text-white hover:border-primary transition-all"
              >
                <span>{link.text}</span>
                <span class="text-primary-container group-hover:text-white text-xs">→</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Related Articles Section -->
      {relatedArticles && relatedArticles.length > 0 && (
        <section class="space-y-6 pt-6 border-t border-primary/10">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div>
              <h3 class="font-headline-sm text-lg md:text-xl font-bold text-on-surface">
                Articles et guides recommandés
              </h3>
              <p class="text-xs text-on-surface-variant">Poursuivez votre lecture pour bien entretenir votre plomberie à Mons</p>
            </div>
            <a href="/blog" class="text-xs font-bold text-primary hover:underline flex items-center gap-1">
              <span>Voir les 30 guides</span>
              <span>→</span>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {relatedArticles.map((rel) => (
              <a
                href={`/blog/${rel.slug}`}
                class="group block p-4 rounded-xl bg-surface-container-lowest border border-primary/10 hover:border-primary/30 hover:shadow-md transition-all flex flex-col justify-between"
              >
                <div class="space-y-2">
                  <span class="inline-block px-2 py-0.5 rounded text-[11px] font-bold bg-surface-container text-primary">
                    {rel.category}
                  </span>
                  <h4 class="font-bold text-xs md:text-sm text-on-surface group-hover:text-primary transition-colors line-clamp-2">
                    {rel.h1}
                  </h4>
                  <p class="text-[11px] text-on-surface-variant line-clamp-2">
                    {rel.quickAnswer}
                  </p>
                </div>
                <div class="pt-3 text-[11px] font-bold text-primary-container flex items-center gap-1">
                  <span>Lire le guide</span>
                  <span class="group-hover:translate-x-1 transition-transform">→</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Performance and Live Response Stats Component -->
      <div class="mt-12">
        <ResponseTimeStats />
      </div>

      <!-- Final Interactive Quote Form -->
      <div class="mt-12">
        <QuoteForm
          title="Demander une Intervention Immédiate ou un Devis"
          subtitle="Formulaire direct pour Mons et communes voisines (dépannage en 30 minutes)"
        />
      </div>

    </div>
  </article>

  <!-- Review Badges Ribbon -->
  <ReviewBadges />
</Layout>

<style>
  /* Rich styling for rendered markdown content in articles */
  :global(.article-content h2) {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-primary, #0c2340);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  @media (min-width: 768px) {
    :global(.article-content h2) {
      font-size: 1.6rem;
    }
  }
  :global(.article-content h3) {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary, #0c2340);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  :global(.article-content p) {
    margin-bottom: 1rem;
    line-height: 1.7;
    color: var(--color-on-surface-variant, #4a5568);
  }
  :global(.article-content ul),
  :global(.article-content ol) {
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  :global(.article-content ul) {
    list-style-type: disc;
  }
  :global(.article-content ol) {
    list-style-type: decimal;
  }
  :global(.article-content li) {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }
  :global(.article-content a) {
    color: #0284c7;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(.article-content a:hover) {
    color: #0369a1;
  }
  :global(.article-content table) {
    width: 100%;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  :global(.article-content th) {
    background-color: #0c2340;
    color: white;
    padding: 0.65rem 0.75rem;
    text-align: left;
    font-weight: 700;
  }
  :global(.article-content td) {
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid rgba(12, 35, 64, 0.1);
  }
  :global(.article-content code) {
    background: #f1f5f9;
    color: #0f172a;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    font-size: 0.85em;
  }
</style>
